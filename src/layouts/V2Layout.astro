---
import { Font } from 'astro:assets';
import Navbar from '../components/v2/Navbar.astro';
import { getV2Messages } from '../i18n/v2';
import '../styles/v2/global.css';

const { title } = Astro.props;
const locale = Astro.currentLocale ?? 'en';
const messages = getV2Messages(locale);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" href="/favicon.png" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title ? `${title} | UNSW DataSoc` : 'UNSW DataSoc'}</title>
    <Font cssVariable="--font-syne" preload />
    <Font cssVariable="--font-inter" preload />
    <slot name="head" />
  </head>
  <body
    class:list={[{ 'pt-16': Astro.url.pathname.replace(/\/$/, '') !== '/v2' }]}
  >
    <a class="skip-link" href="#main-content">{messages['site.skipContent']}</a>
    <Navbar />
    <slot />
  </body>
</html>

<style>
  :global(html),
  :global(body) {
    margin: 0;
  }

  /* Keeps whatever keyboard focus scrolls to clear of the fixed navbar, which reappears when scrolling up. */
  :global(html) {
    scroll-padding-top: 4.5rem;
  }

  .skip-link {
    position: fixed;
    top: 0.5rem;
    left: 0.5rem;
    z-index: 100;
    padding: 0.6rem 1rem;
    border-radius: 0.35rem;
    background: #484b70;
    color: #fffcf3;
    font-family: var(--font-syne), sans-serif;
    font-weight: 700;
    transform: translateY(calc(-100% - 1rem));
  }

  .skip-link:focus-visible {
    transform: none;
    outline: 2px solid #fffcf3;
    outline-offset: -4px;
  }

  :global(html.lenis),
  :global(html.lenis body) {
    height: auto;
  }

  :global(.lenis.lenis-smooth) {
    scroll-behavior: auto !important;
  }

  :global(.lenis.lenis-smooth iframe) {
    pointer-events: none;
  }

  /* No rubber-band bounce past either end of the page, where on iOS the fixed navbar stays put while the page pulls
     away beneath it. This also turns off pull-to-refresh on Android. */
  :global(html) {
    overscroll-behavior-y: none;
  }
</style>

<script>
  import Lenis from 'lenis';

  const lenis = new Lenis({
    autoRaf: false,
    lerp: 0.1,
    smoothWheel: true,
    syncTouch: false,
  });

  lenis.on('scroll', () => {
    window.dispatchEvent(new Event('v2-lenis-scroll'));
  });

  // Dispatch a cancelable CustomEvent<{ top: number; immediate: boolean }> to request a Lenis scroll.
  // defaultPrevented tells callers Lenis handled it; otherwise they can fall back to native scrolling.
  window.addEventListener('v2-lenis-scroll-to', (event) => {
    const detail = (event as CustomEvent<{ top?: unknown; immediate?: unknown }>).detail;
    if (!detail || typeof detail.top !== 'number' || !Number.isFinite(detail.top)) return;
    lenis.scrollTo(detail.top, { immediate: detail.immediate === true });
    event.preventDefault();
  });

  const raf = (time: number) => {
    lenis.raf(time);
    requestAnimationFrame(raf);
  };

  requestAnimationFrame(raf);
  document.documentElement.dataset.v2LenisReady = 'true';
  window.dispatchEvent(new Event('v2-lenis-ready'));
</script>

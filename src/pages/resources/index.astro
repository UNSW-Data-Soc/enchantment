---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
---

<Layout title="Resources - UNSW Data Science Society">
  <Header>
    <h1>Our resources</h1>
    <p>Take a look at our resources below!</p>
  </Header>

  <div class="min-h-screen flex flex-col items-center bg-white p-8">

    <!-- Hero Section -->
    <div class="relative w-full max-w-5xl text-center">
      <h1 class="text-6xl font-extrabold text-gray-900 tracking-tight drop-shadow-md">
        Excellr.
      </h1>
      <p class="text-lg text-gray-700 mt-3">
        Try out our 20-Question bank for Pandas and Matplotlib!
      </p>
    </div>

    <!-- Quick Start Topics -->
    <div class="mt-12 flex gap-6">
      <a
        href="/resources/pandas"
        class="group relative px-8 py-4 bg-purple-600 text-white text-lg font-semibold rounded-lg shadow-xl transition-transform transform hover:scale-105 hover:shadow-2xl"
      >
        Pandas for Python
        <span class="absolute -bottom-2 left-1/2 transform -translate-x-1/2 w-24 h-1 bg-white opacity-0 group-hover:opacity-100 transition-opacity"></span>
      </a>

      <a
        href="/resources/matplotlib"
        class="group relative px-8 py-4 bg-purple-600 text-white text-lg font-semibold rounded-lg shadow-xl transition-transform transform hover:scale-105 hover:shadow-2xl"
      >
        Matplotlib for Python
        <span class="absolute -bottom-2 left-1/2 transform -translate-x-1/2 w-24 h-1 bg-white opacity-0 group-hover:opacity-100 transition-opacity"></span>
      </a>
    </div>

    <!-- Animated Divider -->
    <div class="mt-12 w-40 h-1 bg-purple-500 opacity-75 rounded-full animate-pulse"></div>

    <!-- Workshop Resources Section -->
    <div class="mt-12 text-center">
      <h2 class="text-3xl font-semibold text-gray-800">
        Browse through all of our available learning resources
      </h2>
    </div>

    <!-- Dynamic Resources Section -->
    <div class="w-full max-w-5xl mt-8">
      <p id="resources-status" class="text-center text-gray-500">
        Loading resources...
      </p>

      <div
        id="resources-grid"
        class="grid grid-cols-1 md:grid-cols-3 gap-4"
      >
      </div>
    </div>
  </div>
</Layout>

<script>
  const RESOURCES_URL =
    "https://unsw-data-soc.github.io/resources/resources.json";

  const grid = document.getElementById("resources-grid");
  const status = document.getElementById("resources-status");

  function createResourceCard(resource) {
    const card = document.createElement("a");

    card.href = resource.url;
    card.target = "_blank";
    card.rel = "noopener noreferrer";
    card.className =
      "block bg-white border border-gray-200 rounded-lg shadow-sm p-4 hover:shadow-md transition-shadow";

    const topRow = document.createElement("div");
    topRow.className = "flex justify-between items-start mb-1";

    const title = document.createElement("h3");
    title.className = "text-base font-semibold text-gray-900";
    title.textContent = resource.title;

    const icon = document.createElement("span");
    icon.className = "text-gray-500 ml-2";
    icon.textContent = resource.type === "file" ? "📄" : "🔗";

    topRow.appendChild(title);
    topRow.appendChild(icon);

    const category = document.createElement("p");
    category.className = "text-xs text-gray-500 mb-2";
    category.textContent = resource.category;

    const description = document.createElement("p");
    description.className = "text-sm text-gray-700 mb-3";
    description.textContent = resource.description;

    const tags = document.createElement("div");
    tags.className = "flex flex-wrap gap-1";

    if (Array.isArray(resource.tags)) {
      resource.tags.forEach((tag) => {
        const tagElement = document.createElement("span");
        tagElement.className =
          "bg-purple-500 text-white px-2 py-0.5 text-xs rounded-full";
        tagElement.textContent = tag;
        tags.appendChild(tagElement);
      });
    }

    card.appendChild(topRow);
    card.appendChild(category);
    card.appendChild(description);
    card.appendChild(tags);

    return card;
  }

  async function loadResources() {
    try {
      const response = await fetch(`${RESOURCES_URL}?t=${Date.now()}`, {
        cache: "no-store",
      });

      if (!response.ok) {
        throw new Error("Failed to fetch resources");
      }

      const resources = await response.json();

      grid.innerHTML = "";

      resources.forEach((resource) => {
        grid.appendChild(createResourceCard(resource));
      });

      if (resources.length === 0) {
        status.textContent = "No resources available yet.";
      } else {
        status.textContent = "";
      }
    } catch (error) {
      console.error("Failed to load resources:", error);
      status.textContent = "Could not load resources. Please try again later.";
    }
  }

  loadResources();

  setInterval(loadResources, 10 * 60 * 1000);
</script>
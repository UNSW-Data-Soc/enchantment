---
import ContentPage from '../../../components/v2/ContentPage.astro';
import SponsorshipTiers from '../../../components/v2/SponsorshipTiers.astro';
import { getV2Messages } from '../../../i18n/v2';

const messages = getV2Messages(Astro.currentLocale);
---

<ContentPage
  title={messages['sponsorships.title']}
  titleAccent={messages['sponsorships.titleAccent']}
  caption={messages['sponsorships.caption']}
  sectionName={messages['sponsorships.backToTop']}
  scrollToTop
  teamBackground
  flushBody
>
  <div class="sponsorship-intro">
    <p>
      {messages['sponsorships.intro1']}
    </p>
    <p>
      {messages['sponsorships.intro2']}
    </p>
    <p>
      {messages['sponsorships.intro3']} <a href="mailto:external@unswdata.com">external@unswdata.com</a>.
    </p>
  </div>
  <SponsorshipTiers />
</ContentPage>

<style>
  .sponsorship-intro {
    margin: 0;
    padding: clamp(1.5rem, 3vw, 2.5rem) clamp(1.5rem, 4vw, 4.5rem) 1.5rem;
    background: #fffcf3;
    color: #34394b;
    font-size: clamp(0.9rem, 1.15vw, 1rem);
    line-height: 1.5;
  }

  .sponsorship-intro p {
    margin: 0 0 0.8rem;
  }

  .sponsorship-intro a {
    color: #d94a65;
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }
</style>

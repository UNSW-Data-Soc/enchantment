---
import ContentPage from '../../../components/v2/ContentPage.astro';
import EventCard from '../../../components/v2/EventCard.astro';
import ParallaxContainer from '../../../components/v2/ParallaxContainer.astro';
import { fetchEvents, type FacebookEvent } from '../../../api/api.ts';

let events: { upcomingEvents: FacebookEvent[]; pastEvents: FacebookEvent[] } = {
  upcomingEvents: [],
  pastEvents: [],
};

try {
  const response = await fetchEvents();
  if (response.ok) {
    const data = await response.json();
    events = {
      upcomingEvents: Array.isArray(data.upcomingEvents) ? data.upcomingEvents : [],
      pastEvents: Array.isArray(data.pastEvents) ? data.pastEvents : [],
    };
  }
} catch {
  // Keep the page usable if the Facebook API is unavailable during rendering.
}

const upcomingEvents = events.upcomingEvents.toSorted(
  (a, b) => Date.parse(a.start_time) - Date.parse(b.start_time),
);
const pastEvents = events.pastEvents.toSorted(
  (a, b) => Date.parse(b.start_time) - Date.parse(a.start_time),
);
const sampleEvents = ['Sample event — preview', 'Another sample event', 'Sample workshop', 'Sample social event'];
const showSampleEvents = import.meta.env.DEV && pastEvents.length === 0;

// Each section shows this many events at first, and "Show more" reveals the next batch. Hidden cards' lazy images
// don't load until they're shown.
const BATCH_SIZE = 8;
// The first row of the first section with events is usually on screen when the page opens, so its images load first.
const eagerCount = (section: FacebookEvent[]) => (section === (upcomingEvents.length ? upcomingEvents : pastEvents) ? 4 : 0);
---

<ContentPage
  title="Our"
  titleAccent="events"
  caption="Discover the latest and past events we have hosted. Stay updated and join us for upcoming experiences!"
  sectionName="Top"
  scrollToTop
>
  <div class="events-listing">
    <ParallaxContainer speed={0.035} class="event-section-layer">
    <section class="event-section" aria-labelledby="upcoming-events-heading">
      <h2 id="upcoming-events-heading">Upcoming events</h2>
      <div class="event-grid" data-section={upcomingEvents.length ? 'Upcoming events' : undefined} data-focus-target="#upcoming-events-heading">
        {upcomingEvents.map((event, index) => (
          <EventCard event={event} eager={index < eagerCount(upcomingEvents)} hidden={index >= BATCH_SIZE} />
        ))}
        {!upcomingEvents.length && <p class="empty-events" data-section="Upcoming events" data-focus-target="#upcoming-events-heading" data-scroll-position="0.34">No upcoming events right now.</p>}
      </div>
      {upcomingEvents.length > BATCH_SIZE && <button type="button" class="show-more" data-batch={BATCH_SIZE} aria-label="Show more upcoming events">Show more</button>}
    </section>
    </ParallaxContainer>

    <ParallaxContainer speed={0.035} class="event-section-layer">
    <section class="event-section" aria-labelledby="past-events-heading">
      <h2 id="past-events-heading">Past events</h2>
      <div class="event-grid" data-section={pastEvents.length || showSampleEvents ? 'Past events' : undefined} data-focus-target="#past-events-heading">
        {pastEvents.length ? pastEvents.map((event, index) => (
          <EventCard event={event} eager={index < eagerCount(pastEvents)} hidden={index >= BATCH_SIZE} />
        )) : showSampleEvents ? sampleEvents.map((name) => (
          <article class="event-card sample-event">
            <div class="event-image sample-image">
              <span>Event image</span>
            </div>
            <h3>{name}</h3>
          </article>
        )) : <p class="empty-events" data-section="Past events" data-focus-target="#past-events-heading" data-scroll-position="0.34">No past events to show.</p>}
      </div>
      {pastEvents.length > BATCH_SIZE && <button type="button" class="show-more" data-batch={BATCH_SIZE} aria-label="Show more past events">Show more</button>}
    </section>
    </ParallaxContainer>
  </div>
</ContentPage>

<script>
  // Stacks each grid's cards in columns, so every card has the same gap beneath it whatever its cover's shape. Each
  // card goes under the shortest column, in page order, so reading and tab order still run left to right. Without this
  // script the grid falls back to aligned rows.
  const packGrid = (grid: HTMLElement) => {
    const cards = Array.from(grid.querySelectorAll<HTMLElement>(':scope > .event-card:not([hidden])'));
    // The last placement is cleared first: after a breakpoint drops a column, a card still placed in it would add an
    // implicit track, which would be counted as a column and packed into again.
    cards.forEach((card) => card.style.removeProperty('grid-area'));
    const style = getComputedStyle(grid);
    const gap = Math.round(parseFloat(style.columnGap) || 0);
    // Heights are read before any placement is written, so the loop doesn't force a layout per card.
    const heights = cards.map((card) => Math.ceil(card.getBoundingClientRect().height));
    const columnEnds = new Array(style.gridTemplateColumns.split(' ').length).fill(0);
    cards.forEach((card, index) => {
      const column = columnEnds.indexOf(Math.min(...columnEnds));
      card.style.gridColumn = `${column + 1}`;
      card.style.gridRow = `${columnEnds[column] + 1} / span ${heights[index]}`;
      columnEnds[column] += heights[index] + gap;
    });
  };

  document.querySelectorAll<HTMLElement>('.events-listing .event-grid').forEach((grid) => {
    const cards = grid.querySelectorAll<HTMLElement>(':scope > .event-card');
    if (!cards.length) return;

    grid.classList.add('is-packed');
    packGrid(grid);
    // Cards change height as the grid's width, fonts or fallback images change, and when "Show more" reveals them.
    let frame = 0;
    const observer = new ResizeObserver(() => {
      if (!frame) frame = requestAnimationFrame(() => {
        frame = 0;
        packGrid(grid);
      });
    });
    cards.forEach((card) => observer.observe(card));

    const button = grid.parentElement?.querySelector<HTMLButtonElement>(':scope > .show-more');
    button?.addEventListener('click', () => {
      const next = Array.from(grid.querySelectorAll<HTMLElement>(':scope > .event-card[hidden]'))
        .slice(0, Number(button.dataset.batch));
      next.forEach((card) => (card.hidden = false));
      // Placed before focus moves, so the browser scrolls to where the first new card ends up.
      packGrid(grid);
      next[0]?.focus();
      if (!grid.querySelector(':scope > .event-card[hidden]')) button.remove();
    });
  });
</script>

<style>
  .events-listing {
    display: grid;
    gap: clamp(3rem, 7vw, 5.5rem);
    max-width: 78rem;
    margin: 0 auto;
    padding: clamp(1rem, 3vw, 2.5rem) clamp(0.75rem, 2vw, 1.75rem) 0;
  }

  .event-section h2 {
    margin: 0 0 clamp(1.5rem, 3vw, 2.25rem);
    color: #34394b;
    font-size: clamp(1.5rem, 3vw, 2.4rem);
    font-weight: 700;
    line-height: 1.1;
    text-align: center;
  }

  .events-listing :global(.event-section-layer) {
    min-width: 0;
  }

  .event-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 15rem), 1fr));
    gap: clamp(1rem, 2vw, 1.5rem);
  }

  /* Set by the script: 1px rows that each card spans by its own height. */
  .event-grid.is-packed {
    grid-auto-rows: 1px;
    row-gap: 0;
    align-items: start;
  }

  .events-listing :global(.event-card) {
    min-width: 0;
    color: #34394b;
    text-decoration: none;
  }

  .events-listing :global(a.event-card) {
    transition: transform 180ms ease;
  }

  .events-listing :global(a.event-card:hover) {
    transform: translateY(-4px);
  }

  .events-listing :global(.event-image) {
    display: grid;
    place-items: center;
    width: 100%;
    aspect-ratio: 1;
    overflow: hidden;
    border: 1px solid rgb(52 57 75 / 0.12);
    border-radius: 0.35rem;
    background:
      radial-gradient(circle, rgb(52 57 75 / 0.08) 1px, transparent 1.5px) 0 0 / 14px 14px,
      linear-gradient(135deg, #f5e7de, #e4e9eb);
  }

  .events-listing :global(.event-image img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  /* A cover sets the card's shape, with no backdrop behind it. */
  .events-listing :global(.event-image.has-cover) {
    display: block;
    aspect-ratio: auto;
    border: 0;
    background: none;
    box-shadow: 0 2px 8px rgb(52 57 75 / 0.15);
  }

  .events-listing :global(.event-image.has-cover img) {
    display: block;
    height: auto;
  }

  .events-listing :global(.event-detail) {
    margin: 0.25rem 0 0;
    color: #596073;
    font-size: clamp(0.8rem, 1vw, 0.9rem);
    line-height: 1.35;
  }

  .events-listing :global(.event-card h3) {
    margin: 0.75rem 0 0;
    font-size: clamp(0.9rem, 1.2vw, 1.05rem);
    font-weight: 700;
    line-height: 1.3;
  }

  .sample-image span,
  .events-listing :global(.image-placeholder) {
    color: #596073;
    font-size: 1.05rem;
    text-align: center;
  }

  .sample-image span {
    padding: 1rem;
    border: 1px dashed rgb(52 57 75 / 0.35);
  }

  .show-more {
    display: block;
    margin: clamp(1.5rem, 3vw, 2.25rem) auto 0;
    padding: 0.7rem 1.75rem;
    border: 1px solid #34394b;
    border-radius: 999px;
    background: transparent;
    color: #34394b;
    font: inherit;
    font-weight: 700;
    cursor: pointer;
    transition: background-color 180ms ease, color 180ms ease;
  }

  .show-more:hover {
    background: #34394b;
    color: #fffcf3;
  }

  .empty-events {
    grid-column: 1 / -1;
    margin: 0;
    color: #596073;
    padding: clamp(1.5rem, 3vw, 2.25rem);
    border-radius: 0.45rem;
    background: rgb(231 237 238 / 0.72);
    font-size: 1.1rem;
    text-align: center;
  }

  @media (min-width: 900px) {
    .event-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  @media (min-width: 600px) and (max-width: 899px) {
    .event-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 599px) {
    .event-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .events-listing :global(a.event-card) {
      transition: none;
    }

    .events-listing :global(a.event-card:hover) {
      transform: none;
    }
  }
</style>

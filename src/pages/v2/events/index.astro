---
import ContentPage from '../../../components/v2/ContentPage.astro';
import { fetchEvents, type FacebookEvent } from '../../../api/api.ts';

let events: { upcomingEvents: FacebookEvent[]; pastEvents: FacebookEvent[] } = {
  upcomingEvents: [],
  pastEvents: [],
};

try {
  const response = await fetchEvents();
  if (response.ok) {
    const data = await response.json();
    events = {
      upcomingEvents: Array.isArray(data.upcomingEvents) ? data.upcomingEvents : [],
      pastEvents: Array.isArray(data.pastEvents) ? data.pastEvents : [],
    };
  }
} catch {
  // Keep the page usable if the Facebook API is unavailable during rendering.
}

const upcomingEvents = events.upcomingEvents.toSorted(
  (a, b) => Date.parse(a.start_time) - Date.parse(b.start_time),
);
const pastEvents = events.pastEvents.toSorted(
  (a, b) => Date.parse(b.start_time) - Date.parse(a.start_time),
);
const sampleEvents = ['Sample event — preview', 'Another sample event', 'Sample workshop', 'Sample social event'];
---

<ContentPage
  title="Our"
  titleAccent="events"
  caption="Discover the latest and past events we have hosted. Stay updated and join us for upcoming experiences!"
  bodyClass="events-body"
  scrollToTop
>
  <div class="events-listing">
    <section class="event-section" aria-labelledby="upcoming-events-heading" data-section="Upcoming events">
      <h2 id="upcoming-events-heading">Upcoming events</h2>
      <div class="event-grid">
        {upcomingEvents.map((event) => (
          <a class="event-card" href={`https://www.facebook.com/events/${event.id}`} target="_blank" rel="noopener noreferrer">
            <div class="event-image">
              {event.cover?.source ? (
                <img src={event.cover.source} alt="" loading="lazy" decoding="async" />
              ) : (
                <span class="image-placeholder">Event image unavailable</span>
              )}
            </div>
            <h3>{event.name}</h3>
          </a>
        ))}

        {sampleEvents.map((name) => (
          <article class="event-card sample-event">
            <div class="event-image sample-image">
              <span>Event image</span>
            </div>
            <h3>{name}</h3>
          </article>
        ))}
        {!upcomingEvents.length && <p class="empty-events">No upcoming events right now.</p>}
      </div>
    </section>

    <section class="event-section" aria-labelledby="past-events-heading" data-section="Past events">
      <h2 id="past-events-heading">Past events</h2>
      <div class="event-grid">
        {pastEvents.length ? pastEvents.map((event) => (
          <a class="event-card" href={`https://www.facebook.com/events/${event.id}`} target="_blank" rel="noopener noreferrer">
            <div class="event-image">
              {event.cover?.source ? (
                <img src={event.cover.source} alt="" loading="lazy" decoding="async" />
              ) : (
                <span class="image-placeholder">Event image unavailable</span>
              )}
            </div>
            <h3>{event.name}</h3>
          </a>
        )) : <p class="empty-events">No past events to show.</p>}
      </div>
    </section>
  </div>
</ContentPage>

<style>
  .events-listing {
    display: grid;
    gap: clamp(3rem, 7vw, 5.5rem);
    max-width: 90rem;
    margin: 0 auto;
    padding-inline: clamp(0.5rem, 2vw, 1.75rem);
  }

  .event-section h2 {
    margin: 0 0 clamp(1.5rem, 3vw, 2.25rem);
    color: #34394b;
    font-size: clamp(1.5rem, 3vw, 2.4rem);
    font-weight: 700;
    line-height: 1.1;
    text-align: center;
  }

  .event-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 15rem), 1fr));
    gap: clamp(1rem, 2vw, 1.5rem);
  }

  .event-card {
    min-width: 0;
    color: #34394b;
    text-decoration: none;
  }

  a.event-card {
    transition: transform 180ms ease;
  }

  a.event-card:hover {
    transform: translateY(-4px);
  }

  .event-image {
    display: grid;
    place-items: center;
    width: 100%;
    aspect-ratio: 1;
    overflow: hidden;
    border: 1px solid rgb(52 57 75 / 0.12);
    border-radius: 0.35rem;
    background:
      radial-gradient(circle, rgb(52 57 75 / 0.08) 1px, transparent 1.5px) 0 0 / 14px 14px,
      linear-gradient(135deg, #f5e7de, #e4e9eb);
  }

  .event-image img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .event-card h3 {
    margin: 0.75rem 0 0;
    font-size: clamp(0.9rem, 1.2vw, 1.05rem);
    font-weight: 700;
    line-height: 1.3;
  }

  .sample-image span,
  .image-placeholder {
    color: #596073;
    font-size: 1.05rem;
    text-align: center;
  }

  .sample-image span {
    padding: 1rem;
    border: 1px dashed rgb(52 57 75 / 0.35);
  }

  .empty-events {
    grid-column: 1 / -1;
    margin: 0;
    color: #596073;
    font-size: 0.9rem;
    text-align: center;
  }

  @media (min-width: 900px) {
    .event-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  @media (min-width: 600px) and (max-width: 899px) {
    .event-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 599px) {
    .event-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    a.event-card {
      transition: none;
    }

    a.event-card:hover {
      transform: none;
    }
  }
</style>

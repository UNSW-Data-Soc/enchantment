---
import ContentPage from '../../../components/v2/ContentPage.astro';
import EventCard from '../../../components/v2/EventCard.astro';
import ParallaxContainer from '../../../components/v2/ParallaxContainer.astro';
import { fetchEvents, type FacebookEvent } from '../../../api/api.ts';
import { getV2Messages } from '../../../i18n/v2';

const messages = getV2Messages(Astro.currentLocale);

let events: { upcomingEvents: FacebookEvent[]; pastEvents: FacebookEvent[] } = {
  upcomingEvents: [],
  pastEvents: [],
};

try {
  const response = await fetchEvents();
  if (response.ok) {
    const data = await response.json();
    events = {
      upcomingEvents: Array.isArray(data.upcomingEvents) ? data.upcomingEvents : [],
      pastEvents: Array.isArray(data.pastEvents) ? data.pastEvents : [],
    };
  }
} catch {
  // Keep the page usable if the Facebook API is unavailable during rendering.
}

const upcomingEvents = events.upcomingEvents.toSorted(
  (a, b) => Date.parse(a.start_time) - Date.parse(b.start_time),
);
const pastEvents = events.pastEvents.toSorted(
  (a, b) => Date.parse(b.start_time) - Date.parse(a.start_time),
);
const sampleEvents = [
  messages['events.samplePreview'],
  messages['events.sampleAnother'],
  messages['events.sampleWorkshop'],
  messages['events.sampleSocial'],
];
const showSampleEvents = import.meta.env.DEV && pastEvents.length === 0;
---

<ContentPage
  title={messages['events.title']}
  titleAccent={messages['events.titleAccent']}
  caption={messages['events.caption']}
  sectionName={messages['events.backToTop']}
  scrollToTop
>
  <div class="events-listing">
    <ParallaxContainer speed={0.035} class="event-section-layer">
    <section class="event-section" aria-labelledby="upcoming-events-heading">
      <h2 id="upcoming-events-heading">{messages['events.upcoming']}</h2>
      <div class="event-grid" data-section={upcomingEvents.length ? messages['events.upcoming'] : undefined}>
        {upcomingEvents.map((event) => (
          <EventCard event={event} />
        ))}
        {!upcomingEvents.length && <p class="empty-events" data-section={messages['events.upcoming']} data-scroll-position="0.34">{messages['events.noneUpcoming']}</p>}
      </div>
    </section>
    </ParallaxContainer>

    <ParallaxContainer speed={0.035} class="event-section-layer">
    <section class="event-section" aria-labelledby="past-events-heading">
      <h2 id="past-events-heading">{messages['events.past']}</h2>
      <div class="event-grid" data-section={pastEvents.length || showSampleEvents ? messages['events.past'] : undefined}>
        {pastEvents.length ? pastEvents.map((event) => (
          <EventCard event={event} />
        )) : showSampleEvents ? sampleEvents.map((name) => (
          <article class="event-card sample-event">
            <div class="event-image sample-image">
              <span>{messages['events.image']}</span>
            </div>
            <h3>{name}</h3>
          </article>
        )) : <p class="empty-events" data-section={messages['events.past']} data-scroll-position="0.34">{messages['events.nonePast']}</p>}
      </div>
    </section>
    </ParallaxContainer>
  </div>
</ContentPage>

<style>
  .events-listing {
    display: grid;
    gap: clamp(3rem, 7vw, 5.5rem);
    max-width: 78rem;
    margin: 0 auto;
    padding-inline: clamp(0.75rem, 2vw, 1.75rem);
  }

  .event-section h2 {
    margin: 0 0 clamp(1.5rem, 3vw, 2.25rem);
    color: #34394b;
    font-size: clamp(1.5rem, 3vw, 2.4rem);
    font-weight: 700;
    line-height: 1.1;
    text-align: center;
  }

  .events-listing :global(.event-section-layer) {
    min-width: 0;
  }

  .event-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 15rem), 1fr));
    gap: clamp(1rem, 2vw, 1.5rem);
  }

  .events-listing :global(.event-card) {
    min-width: 0;
    color: #34394b;
    text-decoration: none;
  }

  .events-listing :global(a.event-card) {
    transition: transform 180ms ease;
  }

  .events-listing :global(a.event-card:hover) {
    transform: translateY(-4px);
  }

  .events-listing :global(.event-image) {
    display: grid;
    place-items: center;
    width: 100%;
    aspect-ratio: 1;
    overflow: hidden;
    border: 1px solid rgb(52 57 75 / 0.12);
    border-radius: 0.35rem;
    background:
      radial-gradient(circle, rgb(52 57 75 / 0.08) 1px, transparent 1.5px) 0 0 / 14px 14px,
      linear-gradient(135deg, #f5e7de, #e4e9eb);
  }

  .events-listing :global(.event-image img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .events-listing :global(.event-card h3) {
    margin: 0.75rem 0 0;
    font-size: clamp(0.9rem, 1.2vw, 1.05rem);
    font-weight: 700;
    line-height: 1.3;
  }

  .sample-image span,
  .events-listing :global(.image-placeholder) {
    color: #596073;
    font-size: 1.05rem;
    text-align: center;
  }

  .sample-image span {
    padding: 1rem;
    border: 1px dashed rgb(52 57 75 / 0.35);
  }

  .empty-events {
    grid-column: 1 / -1;
    margin: 0;
    color: #596073;
    padding: clamp(1.5rem, 3vw, 2.25rem);
    border-radius: 0.45rem;
    background: rgb(231 237 238 / 0.72);
    font-size: 1.1rem;
    text-align: center;
  }

  @media (min-width: 900px) {
    .event-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  @media (min-width: 600px) and (max-width: 899px) {
    .event-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 599px) {
    .event-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .events-listing :global(a.event-card) {
      transition: none;
    }

    .events-listing :global(a.event-card:hover) {
      transform: none;
    }
  }
</style>

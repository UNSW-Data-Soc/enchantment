---
import V2Layout from "../../../layouts/V2Layout.astro";
import Footer from "../../../components/v2/Footer.astro";
import TeamCard from "../../../components/v2/TeamCard.astro";
import StarsScrollbar from "../../../components/v2/StarsScrollbar.astro";
import { sections } from "../../../data/team";
import cluster from "../../../assets/ui/shapes/blue-red-cluster.svg?url";

const [president, executives, directors] = sections;
const portfolios = [...new Set(directors.members.map((member) => member.role.replace(/ Director$/, '')))]
	.map((name) => ({
		name,
		members: directors.members.filter((member) => member.role === `${name} Director`),
	}));
---

<V2Layout title="Meet the team — UNSW DataSoc">
	<main class="team-page" id="top">
		<StarsScrollbar variant="team" />

		<div class="team-journey">
			<svg class="journey-line" viewBox="0 0 1000 7000" preserveAspectRatio="none" aria-hidden="true">
				<path class="line-track" d="M 700 300 C 950 500 950 850 750 1100 S 50 1700 160 2200 S 950 2800 840 3300 S 50 3900 160 4400 S 950 5000 840 5500 S 50 6200 500 6900" />
				<path class="line-progress" d="M 700 300 C 950 500 950 850 750 1100 S 50 1700 160 2200 S 950 2800 840 3300 S 50 3900 160 4400 S 950 5000 840 5500 S 50 6200 500 6900" />
				<circle class="line-tip" r="9" cx="500" cy="6900" />
			</svg>

			<section class="hero" aria-labelledby="team-heading" data-line-section data-section="Meet the Team">
				<div class="hero-copy">
					<p class="eyebrow">Our people / The team behind it all</p>
					<h1 id="team-heading">Meet<br /> <span>the team.</span></h1>
					<p class="intro">Different people. Shared curiosity. Meet the team making data, friendships and big ideas come together.</p>
					<nav class="section-links" aria-label="Explore the team">
						<a href="#president">President <span aria-hidden="true">↘</span></a>
						<a href="#executives">Executives <span aria-hidden="true">↘</span></a>
						<a href="#directors">Directors <span aria-hidden="true">↘</span></a>
					</nav>
				</div>
				<div class="hero-art" aria-hidden="true">
					<div class="art-disc"></div>
					<img class="art-cluster" src={cluster} alt="" />
					<div class="art-ring"></div>
					<span class="art-spark">✦</span>
					<span class="art-type">Many minds.<br /><strong>One team.</strong></span>
				</div>
				<p class="scroll-note">Follow the thread. Find your people. <span aria-hidden="true">↓</span></p>
			</section>

			<section class="president content-section" id="president" aria-labelledby="president-heading" data-line-section data-section="President">
				<div class="section-art president-art" aria-hidden="true"></div>
				<div class="president-copy">
					<p class="eyebrow">01 / Leading the way</p>
					<h2 id="president-heading">Our<br /><em>President.</em></h2>
					<p>Bringing the people, portfolios and possibilities together.</p>
				</div>
				<div class="president-card">
					<span class="portrait-orbit" aria-hidden="true"></span>
					<TeamCard member={president.members[0]} featured />
				</div>
			</section>

			<section class="executives content-section" id="executives" aria-labelledby="executives-heading" data-line-section data-section="Executives">
				<img class="section-art executive-art" src={cluster} alt="" loading="lazy" />
				<div class="section-heading">
					<p class="eyebrow">02 / Making it happen</p>
					<h2 id="executives-heading">The <em>Executives.</em></h2>
					<p>The crew connecting all the moving parts of DataSoc.</p>
				</div>
				<div class="executive-grid">
					{executives.members.map((member) => <TeamCard member={member} />)}
				</div>
			</section>

			<section class="directors content-section" id="directors" aria-labelledby="directors-heading" data-section="Directors">
				<div class="section-art director-art" aria-hidden="true"></div>
				<div class="section-heading" data-line-section>
					<p class="eyebrow">03 / Ideas into action</p>
					<h2 id="directors-heading">Meet our <em>Directors.</em></h2>
					<p>Many portfolios. One team. Find the people behind each part of the society.</p>
				</div>
				<div class="portfolio-grid">
					{portfolios.map((portfolio, index) => (
						<section class="portfolio" aria-labelledby={`portfolio-${index}`} data-line-section>
							<div class="portfolio-heading">
								<span class="portfolio-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
								<h3 id={`portfolio-${index}`}>{portfolio.name}</h3>
							</div>
							<div class="director-grid">
								{portfolio.members.map((member) => <TeamCard member={member} />)}
							</div>
						</section>
					))}
				</div>
			</section>

			<div class="journey-end" data-line-section>
				<span aria-hidden="true">✳</span>
				<p>Different threads.<br /><strong>One DataSoc.</strong></p>
				<a href="#top">Back to the top ↑</a>
			</div>
		</div>
	</main>

	<Footer />
</V2Layout>

<style>
	:global(body) { background: #fffcf3; }
	.team-page {
		position: relative;
		color: #292929;
		font-family: var(--font-syne), sans-serif;
		overflow: clip;
		background: #fffcf3;
		padding-left: 4.13%;
	}
	.team-page * { box-sizing: border-box; }
	a { color: inherit; text-underline-offset: 5px; }
	a:focus-visible { outline: 3px solid #137aa8; outline-offset: 7px; }
	.team-journey { position: relative; isolation: isolate; }
	.journey-line { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 1; pointer-events: none; }
	.journey-line path { fill: none; stroke-width: 4; vector-effect: non-scaling-stroke; }
	.line-track { stroke: #d94a65; opacity: 0.16; }
	.line-progress { stroke: #d94a65; }
	.line-tip { fill: #119bd6; stroke: #fffcf3; stroke-width: 3; }
	.hero {
		position: relative;
		padding: 110px max(6%, calc((100% - 1160px) / 2)) 150px;
		min-height: 760px;
		background: radial-gradient(ellipse at 85% 20%, #f4b00025, transparent 50%), #fffcf3;
	}
	.hero-copy { position: relative; z-index: 2; max-width: 680px; }
	.eyebrow { margin: 0 0 24px; text-transform: uppercase; letter-spacing: 0.16em; font-size: 0.72rem; font-weight: 700; line-height: 1.8; }
	h1 { margin: 0; font-size: clamp(4rem, 8.5vw, 8rem); line-height: 0.98; letter-spacing: -0.065em; font-weight: 800; }
	h1 span { position: relative; display: inline-block; color: #b13250; margin: 12px 0 10px; }
	h1 span::after { content: ''; position: absolute; z-index: -1; bottom: 0; left: -3%; width: 106%; height: 22%; background: #f4b000; border-radius: 50%; transform: rotate(-4deg); }
	.intro { max-width: 440px; margin: 28px 0; font-size: 1rem; line-height: 1.8; }
	.section-links { display: flex; flex-wrap: wrap; gap: 12px; }
	.section-links a { padding: 10px 16px; border: 1px solid #29292970; border-radius: 30px; text-decoration: none; font-size: 0.8rem; background: #fffcf3; }
	.section-links a:hover { background: #f6dfa6; }
	.section-links span { margin-left: 12px; }
	.hero-art { position: absolute; z-index: 1; right: 1%; top: 70px; width: 43%; height: 560px; pointer-events: none; }
	.art-disc { position: absolute; inset: 10% 0 12% 10%; background: #f4b000; border-radius: 50% 50% 5% 50%; transform: rotate(-15deg); }
	.art-cluster { position: absolute; width: 115%; height: 115%; object-fit: contain; top: -12%; left: -10%; transform: rotate(18deg); }
	.art-ring { position: absolute; inset: 16% -10% 10% -5%; border: 2px solid #292929; border-radius: 50%; transform: rotate(-30deg) scaleY(0.52); }
	.art-spark { position: absolute; top: 0; right: 12%; font-size: 110px; color: #d94a65; }
	.art-type { position: absolute; right: 6%; bottom: 0; font-size: clamp(1.3rem, 2.5vw, 2rem); line-height: 1.15; letter-spacing: -0.04em; text-align: right; }
	.art-type strong { color: #137aa8; }
	.scroll-note { position: relative; z-index: 2; margin: 45px 0 0; font-size: 0.72rem; letter-spacing: 0.08em; }
	.scroll-note span { margin-left: 20px; font-size: 1.3rem; }
	.content-section { position: relative; padding: 110px max(7%, calc((100% - 1100px) / 2)); scroll-margin-top: 35px; }
	.section-art { position: absolute; pointer-events: none; }
	.president-art { width: 65%; height: 75%; right: -12%; top: 12%; border-radius: 50% 0 0 50%; background: #f4b000; transform: rotate(-12deg); }
	.president-art::before { content: ''; position: absolute; inset: -12% 15% 0 -7%; border: 2px solid #119bd6; border-radius: 50%; transform: rotate(25deg); }
	.executive-art { width: 70%; height: 80%; object-fit: contain; right: -24%; top: -10%; transform: rotate(35deg); opacity: 0.75; }
	.director-art { left: -15%; top: 0; width: 65%; height: 400px; background: #f4b000; border-radius: 50%; transform: rotate(-25deg); }
	.director-art::after { content: ''; position: absolute; inset: 35% -50% -15% 30%; background: #d94a65; border-radius: 50%; }
	h2 { margin: 0; font-size: clamp(2.5rem, 5vw, 4.5rem); line-height: 1.1; letter-spacing: -0.05em; }
	h2 em { color: #b13e55; font-style: normal; }
	.section-heading { position: relative; z-index: 2; margin-bottom: 70px; text-align: center; }
	.section-heading h2 { display: inline-block; padding: 10px 20px; }
	.section-heading > p:last-child { max-width: 480px; margin: 20px auto 0; font-size: 0.95rem; line-height: 1.8; }
	.president { display: grid; grid-template-columns: 1fr 1fr; align-items: center; gap: 80px; background: #fffcf3; }
	.president-copy { position: relative; z-index: 2; max-width: 390px; padding: 30px 0; }
	.president-copy > p:not(.eyebrow) { max-width: 290px; line-height: 1.8; }
	.president-card { position: relative; z-index: 2; width: min(100%, 360px); justify-self: center; }
	.portrait-orbit { position: absolute; z-index: 3; inset: 45% -20% 10%; border: 2px solid #137aa8; border-radius: 50%; transform: rotate(-20deg); pointer-events: none; }
	.executives { background: #fffcf3; }
	.executive-grid { position: relative; z-index: 2; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 48px; max-width: 880px; margin: auto; }
	.directors { background: #fffcf3; }
	.directors h2 em { color: #137aa8; }
	.portfolio-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 80px 60px; }
	.portfolio { position: relative; min-width: 0; padding: 25px 18px 30px; }
	.portfolio::before { content: ''; position: absolute; inset: 28% -2% 10%; border-radius: 50% 50% 5% 5%; background: #119bd61a; transform: rotate(-5deg); }
	.portfolio:nth-child(3n + 2)::before { background: #d94a651a; transform: rotate(5deg); }
	.portfolio:nth-child(3n)::before { background: #f4b00030; }
	.portfolio-heading { position: relative; z-index: 2; display: flex; gap: 14px; align-items: baseline; margin-bottom: 35px; }
	.portfolio-heading h3 { margin: 0; font-size: 1.15rem; }
	.portfolio-number { font-size: 0.75rem; color: #137aa8; border-bottom: 2px solid #f4b000; padding: 6px; }
	.director-grid { position: relative; z-index: 2; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; }
	.journey-end { position: relative; z-index: 2; padding: 70px 20px 100px; text-align: center; background: radial-gradient(ellipse at 0 100%, #d94a65 0 18%, transparent 18.2%), radial-gradient(ellipse at 105% 70%, #f4b000 0 23%, transparent 23.2%), #fffcf3; }
	.journey-end > span { color: #d94a65; font-size: 5rem; }
	.journey-end p { font-size: clamp(1.8rem, 4vw, 3rem); line-height: 1.25; letter-spacing: -0.04em; }
	.journey-end a { font-size: 0.8rem; }

	@media (max-width: 1099px) {
		.hero-art { right: -5%; top: 120px; transform: scale(0.85); transform-origin: right top; }
		.hero-copy { max-width: 65%; }
		.portfolio-grid { gap: 60px 35px; }
		.executive-grid { gap: 30px; }
	}
	@media (max-width: 799px) {
		.hero { padding-top: 65px; padding-bottom: 120px; min-height: auto; }
		.hero-copy { max-width: 100%; }
		.hero-art { position: relative; top: auto; right: auto; margin: 40px auto 0; transform: none; width: min(100%, 400px); height: 380px; }
		.intro { max-width: 100%; }
		.content-section { padding: 70px 7%; }
		.president { gap: 40px; }
		.president-copy { max-width: 100%; }
		.president { grid-template-columns: 1fr; }
		.president-card { width: min(80vw, 340px); }
		.executive-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 32px 22px; }
		.portfolio-grid { grid-template-columns: 1fr; gap: 60px; }
		.director-grid { gap: 18px; }
		.section-heading { margin-bottom: 42px; }
		.section-heading > p:last-child { font-size: 0.9rem; }
		.journey-line path { stroke-width: 2; }
	}
	@media (max-width: 599px) {
		.content-section { padding-inline: 6%; }
		.portfolio { padding-inline: 12px; }
		.president-copy { padding: 22px 0; }
		.president-card { width: min(100%, 340px); }
		h1 { font-size: clamp(3rem, 12vw, 5rem); }
		.section-heading h2 { padding-inline: 10px; }
	}
	@media (max-width: 399px) {
		h1 { font-size: 3rem; }
		.section-links { gap: 8px; }
		.section-links a { padding: 9px 11px; font-size: 0.72rem; }
		.section-links span { margin-left: 5px; }
	}
	@media (prefers-reduced-motion: reduce) {
		.line-tip { display: none; }
	}
</style>

<script>
	const journey = document.querySelector<HTMLElement>('.team-journey');
	const svg = journey?.querySelector<SVGSVGElement>('.journey-line');
	const track = svg?.querySelector<SVGPathElement>('.line-track');
	const progress = svg?.querySelector<SVGPathElement>('.line-progress');
	const tip = svg?.querySelector<SVGCircleElement>('.line-tip');

	if (journey && svg && track && progress && tip) {
		const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
		let length = 0;
		let frame = 0;

		const draw = () => {
			frame = 0;
			if (reducedMotion.matches) {
				progress.style.strokeDashoffset = '0';
				return;
			}
			// Match the line's tip to the reading position, rather than assuming equal
			// distances along a curve correspond to equal distances down the page.
			const y = window.innerHeight * 0.7 - journey.getBoundingClientRect().top;
			let low = 0;
			let high = length;
			for (let i = 0; i < 14; i++) {
				const midpoint = (low + high) / 2;
				if (progress.getPointAtLength(midpoint).y < y) low = midpoint;
				else high = midpoint;
			}
			const distance = (low + high) / 2;
			const point = progress.getPointAtLength(distance);
			progress.style.strokeDashoffset = `${length - distance}`;
			tip.setAttribute('cx', `${point.x}`);
			tip.setAttribute('cy', `${point.y}`);
		};

		const scheduleDraw = () => {
			if (!frame) frame = requestAnimationFrame(draw);
		};

		const resize = () => {
			const bounds = journey.getBoundingClientRect();
			const anchors = Array.from(journey.querySelectorAll<HTMLElement>('[data-line-section]'))
				.map((section) => section.getBoundingClientRect().top - bounds.top + 65)
				.sort((a, b) => a - b)
				.filter((y, i, positions) => i === 0 || y - positions[i - 1] > 1);
			const points = anchors.map((y, i) => ({
				x: bounds.width * (i % 2 === 0 ? 0.9 : 0.1),
				y,
			}));
			let d = `M ${points[0].x} ${points[0].y}`;
			for (let i = 1; i < points.length; i++) {
				const previous = points[i - 1];
				const current = points[i];
				const middle = (previous.y + current.y) / 2;
				d += ` C ${previous.x} ${middle}, ${current.x} ${middle}, ${current.x} ${current.y}`;
			}
			svg.setAttribute('viewBox', `0 0 ${bounds.width} ${bounds.height}`);
			track.setAttribute('d', d);
			progress.setAttribute('d', d);
			length = progress.getTotalLength();
			progress.style.strokeDasharray = `${length}`;
			scheduleDraw();
		};

		window.addEventListener('scroll', scheduleDraw, { passive: true });
		window.addEventListener('v2-lenis-scroll', scheduleDraw);
		reducedMotion.addEventListener('change', scheduleDraw);
		new ResizeObserver(resize).observe(journey);
		resize();
	}
</script>

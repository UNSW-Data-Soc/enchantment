---
import Container from '../../../components/Container.astro';
import Footer from '../../../components/v2/Footer.astro';
import V2Layout from '../../../layouts/V2Layout.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

const photos = import.meta.glob<{ default: ImageMetadata }>(
    '../../../assets/meet-the-team/datasoc-board-photos/*.jpg',
    { eager: true },
);

function photo(file?: string): ImageMetadata | undefined {
    if (!file) return undefined;
    const entry = photos[`../../../assets/meet-the-team/datasoc-board-photos/${file}`];
    if (!entry) throw new Error(`Board photo not found: ${file}`);
    return entry.default;
}

const IMAGE_WIDTHS = [240, 380, 540, 700];

type Member = { name: string; role: string; file?: string };
type Section = {
    title: string;
    cardClass: string;
    sizes: string;
    eager?: boolean;
    members: Member[];
};

const sections: Section[] = [
    {
        title: 'President',
        cardClass: 'w-[70%] sm:w-[50%] md:w-[32%] lg:w-[24%]',
        sizes: '(min-width: 1024px) 276px, (min-width: 768px) 32vw, (min-width: 640px) 50vw, 70vw',
        eager: true,
        members: [{ name: 'Qingyuan He', role: 'President', file: 'qingyuan_h.jpg' }],
    },
    {
        title: 'Executives',
        cardClass: 'w-[42%] sm:w-[38%] md:w-[28%] lg:w-[22%]',
        sizes: '(min-width: 1024px) 253px, (min-width: 768px) 28vw, (min-width: 640px) 38vw, 42vw',
        members: [
            { name: 'Ethan Pham', role: 'Vice President (Activities)', file: 'ethan_p.jpg' },
            { name: 'Stella Lin', role: 'Vice President (Development)', file: 'stella_l.jpg' },
            { name: 'Naisha Kulshreshtha', role: 'Vice President (External)' },
            { name: 'Andre Baruah', role: 'Vice President (Operations)', file: 'andre_b.jpg' },
            { name: 'Akhil Panwar', role: 'Secretary', file: 'akhil_p.jpg' },
            { name: 'Aaron Chen', role: 'Treasurer' },
        ],
    },
    {
        title: 'Directors',
        cardClass: 'w-[42%] md:w-[28%] lg:w-[22%]',
        sizes: '(min-width: 1024px) 253px, (min-width: 768px) 28vw, 42vw',
        members: [
            { name: 'Aaron Wong', role: 'Human Resources Director' },
            { name: 'Yatha Shah', role: 'Human Resources Director', file: 'yatha_s.jpg' },
            { name: 'Linh Pham', role: 'Social Director', file: 'linh_p.jpg' },
            { name: 'Jason Nguyen', role: 'Social Director' },
            { name: 'Lily Tang', role: 'Education Director', file: 'lily_t.jpg' },
            { name: 'Minjun Kim', role: 'Education Director', file: 'minjun_k.jpg' },
            { name: 'Anoushka Pandey', role: 'Philanthropy & Projects Director', file: 'anoushka_p.jpg' },
            { name: 'Isabella Fan', role: 'Philanthropy & Projects Director', file: 'isabella_f.jpg' },
            { name: 'Liam Lightfoot', role: 'Careers Director' },
            { name: 'Vidisha Trivedi', role: 'Careers Director', file: 'vidisha_t.jpg' },
            { name: 'Cathy Dinh', role: 'Sponsorships Director', file: 'cathy_d.jpg' },
            { name: 'Simon Shen', role: 'Sponsorships Director' },
            { name: 'Kai Lu', role: 'Technology Director', file: 'kai_l.jpg' },
            { name: 'Shafquat Tabeeb', role: 'Technology Director', file: 'shafquat_t.jpg' },
            { name: 'Jennifer Lee', role: 'Marketing Director', file: 'jennifer_l.jpg' },
            { name: 'Shashwat Manish', role: 'Marketing Director' },
            { name: 'Shreya Verma', role: 'Media Director', file: 'shreya_v.jpg' },
            { name: 'Vedant Tyagi', role: 'Media Director', file: 'vedant_t.jpg' },
        ],
    },
];
---

<V2Layout title="Meet the team - UNSW Data Science Society">
    <main class="team-page">
        <header class="team-hero">
            <p class="team-eyebrow">UNSW Data Science Society</p>
            <h1>Meet the team</h1>
            <p class="team-intro">Meet the people behind UNSW DataSoc.</p>
        </header>

        <Container class="team-roster space-y-16 py-12 max-w-6xl">
            {sections.map((section) => (
                <section class="team-section space-y-6">
                    <h2>{section.title}</h2>

                    <div class="flex flex-wrap justify-center gap-8">
                        {section.members.map((member) => {
                            const image = photo(member.file);
                            return (
                                <div class:list={['member-card text-center', section.cardClass]}>
                                    {image ? (
                                        <Image
                                            src={image}
                                            alt={member.name}
                                            widths={IMAGE_WIDTHS}
                                            sizes={section.sizes}
                                            loading={section.eager ? 'eager' : 'lazy'}
                                            class="member-photo w-full h-80 object-cover"
                                        />
                                    ) : (
                                        <div
                                            class="member-photo photo-placeholder w-full h-80 flex items-center justify-center"
                                            role="img"
                                            aria-label={`${member.name} photo unavailable`}
                                        >
                                            <span aria-hidden="true">Photo unavailable</span>
                                        </div>
                                    )}
                                    <p class="member-name">{member.name}</p>
                                    <p class="member-role">{member.role}</p>
                                </div>
                            );
                        })}
                    </div>
                </section>
            ))}
        </Container>
    </main>

    <Footer />
</V2Layout>

<style>
    .team-page {
        --team-ink: #484b70;
        --team-cream: #fffcf3;
        --team-blue: #137aa8;
        background: var(--team-cream);
        color: var(--team-ink);
        font-family: var(--font-syne), sans-serif;
    }

    .team-hero {
        position: relative;
        isolation: isolate;
        overflow: hidden;
        padding: clamp(4rem, 9vw, 8rem) 1.5rem;
        text-align: center;
        background:
            radial-gradient(ellipse at 16% 15%, rgb(238 135 150 / 0.2), transparent 38%),
            radial-gradient(ellipse at 85% 90%, rgb(255 227 166 / 0.48), transparent 42%),
            linear-gradient(110deg, #f3e9e6, #fefbf0);
    }

    .team-hero::after {
        position: absolute;
        inset: auto 0 0;
        z-index: -1;
        height: 0.45rem;
        background: linear-gradient(90deg, #ee8796, #ffe3a6, #c3ffff);
        content: '';
    }

    .team-eyebrow {
        margin: 0 0 0.75rem;
        color: var(--team-blue);
        font-size: 0.8rem;
        font-weight: 700;
        letter-spacing: 0.16em;
        text-transform: uppercase;
    }

    .team-hero h1 {
        margin: 0;
        font-size: clamp(2.5rem, 7vw, 5.5rem);
        font-weight: 800;
        letter-spacing: -0.055em;
    }

    .team-intro {
        margin: 1rem 0 0;
        color: var(--team-blue);
        font-size: clamp(1rem, 2vw, 1.25rem);
    }

    .team-roster {
        padding-top: clamp(3rem, 7vw, 5rem);
        padding-bottom: clamp(4rem, 8vw, 6rem);
    }

    .team-section h2 {
        width: fit-content;
        margin: 0 auto;
        padding-bottom: 0.55rem;
        border-bottom: 3px solid transparent;
        border-image: linear-gradient(90deg, #ee8796, #ffe3a6) 1;
        color: var(--team-ink);
        font-size: clamp(1.5rem, 3vw, 2rem);
        font-weight: 700;
        text-align: center;
    }

    .member-card {
        overflow: hidden;
        padding: 0.65rem 0.65rem 1rem;
        border: 1px solid rgb(72 75 112 / 0.1);
        border-radius: 1rem;
        background: #fffefa;
        box-shadow: 0 0.5rem 1.5rem rgb(72 75 112 / 0.08);
        transition:
            transform 250ms ease,
            box-shadow 250ms ease;
    }

    .member-card:hover {
        transform: translateY(-0.25rem);
        box-shadow: 0 0.85rem 2rem rgb(72 75 112 / 0.14);
    }

    .member-photo {
        border-radius: 0.65rem;
    }

    .photo-placeholder {
        border: 1px solid rgb(19 122 168 / 0.12);
        background: linear-gradient(135deg, #e8f8f7, #fff2ec);
        color: var(--team-blue);
        font-size: 0.875rem;
    }

    .member-name {
        margin: 0.9rem 0 0;
        color: var(--team-ink);
        font-size: 1rem;
        font-weight: 700;
    }

    .member-role {
        margin: 0.2rem 0 0;
        color: var(--team-blue);
        font-size: 0.875rem;
    }

    @media (prefers-reduced-motion: reduce) {
        .member-card {
            transition: none;
        }
    }
</style>

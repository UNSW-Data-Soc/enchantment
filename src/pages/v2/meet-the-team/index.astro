---
import Container from '../../../components/Container.astro';
import Footer from '../../../components/v2/Footer.astro';
import TeamMemberDetails from '../../../components/v2/TeamMemberDetails.astro';
import V2Layout from '../../../layouts/V2Layout.astro';
import star from '../../../assets/ui/shapes/one-star.svg?url';
import type { ImageMetadata } from 'astro';

const LEADERSHIP_SIZES = '(min-width: 1440px) 250px, (min-width: 768px) 22vw, (min-width: 640px) 150px, 42vw';
const PORTFOLIO_SIZES = '(min-width: 1440px) 265px, (min-width: 768px) 18vw, (min-width: 640px) 20vw, 42vw';
const PORTFOLIO_VARIANTS = 4;
const photos = import.meta.glob<{ default: ImageMetadata }>(
    '../../../assets/meet-the-team/datasoc-board-photos/*.jpg',
    { eager: true },
);

function photo(file?: string): ImageMetadata | undefined {
    if (!file) return undefined;
    const entry = photos[`../../../assets/meet-the-team/datasoc-board-photos/${file}`];
    if (!entry) throw new Error(`Board photo not found: ${file}`);
    return entry.default;
}

type Member = { name: string; role: string; file?: string };
type Section = {
    title: string;
    sizes: string;
    eager?: boolean;
    members: Member[];
};

const leadership: Section[] = [
    {
        title: 'President',
        sizes: LEADERSHIP_SIZES,
        eager: true,
        members: [{ name: 'Qingyuan He', role: 'President', file: 'qingyuan_h.jpg' }],
    },
    {
        title: 'Executives',
        sizes: LEADERSHIP_SIZES,
        members: [
            { name: 'Ethan Pham', role: 'Vice President (Activities)', file: 'ethan_p.jpg' },
            { name: 'Stella Lin', role: 'Vice President (Development)', file: 'stella_l.jpg' },
            { name: 'Naisha Kulshreshtha', role: 'Vice President (External)' },
            { name: 'Andre Baruah', role: 'Vice President (Operations)', file: 'andre_b.jpg' },
            { name: 'Akhil Panwar', role: 'Secretary', file: 'akhil_p.jpg' },
            { name: 'Aaron Chen', role: 'Treasurer' },
        ],
    },
];

const directors: Member[] = [
    { name: 'Aaron Wong', role: 'Human Resources Director' },
    { name: 'Yatha Shah', role: 'Human Resources Director', file: 'yatha_s.jpg' },
    { name: 'Linh Pham', role: 'Social Director', file: 'linh_p.jpg' },
    { name: 'Jason Nguyen', role: 'Social Director' },
    { name: 'Lily Tang', role: 'Education Director', file: 'lily_t.jpg' },
    { name: 'Minjun Kim', role: 'Education Director', file: 'minjun_k.jpg' },
    { name: 'Anoushka Pandey', role: 'Philanthropy & Projects Director', file: 'anoushka_p.jpg' },
    { name: 'Isabella Fan', role: 'Philanthropy & Projects Director', file: 'isabella_f.jpg' },
    { name: 'Liam Lightfoot', role: 'Careers Director' },
    { name: 'Vidisha Trivedi', role: 'Careers Director', file: 'vidisha_t.jpg' },
    { name: 'Cathy Dinh', role: 'Sponsorships Director', file: 'cathy_d.jpg' },
    { name: 'Simon Shen', role: 'Sponsorships Director' },
    { name: 'Kai Lu', role: 'Technology Director', file: 'kai_l.jpg' },
    { name: 'Shafquat Tabeeb', role: 'Technology Director', file: 'shafquat_t.jpg' },
    { name: 'Jennifer Lee', role: 'Marketing Director', file: 'jennifer_l.jpg' },
    { name: 'Shashwat Manish', role: 'Marketing Director' },
    { name: 'Shreya Verma', role: 'Media Director', file: 'shreya_v.jpg' },
    { name: 'Vedant Tyagi', role: 'Media Director', file: 'vedant_t.jpg' },
];

const portfolios = Array.from(
    directors.reduce((groups, member) => {
        const title = member.role.replace(/ Director$/, '');
        const members = groups.get(title) ?? [];
        members.push(member);
        groups.set(title, members);
        return groups;
    }, new Map<string, Member[]>()),
    ([title, members]) => ({
        title,
        sizes: PORTFOLIO_SIZES,
        members,
    }),
);
---

<V2Layout title="Meet the team - UNSW Data Science Society">
    <div class="team-page">
        <div class="ambient-background" aria-hidden="true">
            <span class="ambient-cloud cloud-one" data-depth="0.06"></span>
            <span class="ambient-cloud cloud-two" data-depth="0.1"></span>
            <span class="ambient-sun" data-depth="0.035"></span>
        </div>

        <div class="team-panel">
            <div class="team-body">
                <svg class="scroll-trail" aria-hidden="true" preserveAspectRatio="none">
                    <defs>
                        <linearGradient id="trail-gradient" x1="0" y1="0" x2="0" y2="1">
                            <stop offset="0%" stop-color="var(--team-accent-pink)" />
                            <stop offset="48%" stop-color="var(--team-accent-purple)" />
                            <stop offset="100%" stop-color="var(--team-accent-blue)" />
                        </linearGradient>
                    </defs>
                    <path class="trail-base" />
                    <path class="trail-progress" />
                    <circle class="trail-dot" r="8" />
                </svg>

                <nav class="team-progress-rail" aria-label="Page sections" style={`--star: url("${star}")`}>
                    <div class="rail-track">
                        <div class="rail-stars"></div>
                    </div>
                </nav>

                <main
                    class="team-content"
                    data-trail-section
                    data-team-stop="Meet the team & President"
                    tabindex="-1"
                >
                    <header class="team-hero">
                        <span class="hero-cloud cloud-left" data-depth="0.12" aria-hidden="true"></span>
                        <span class="hero-cloud cloud-right" data-depth="0.08" aria-hidden="true"></span>
                        <span class="hero-orbit orbit-one" aria-hidden="true"></span>
                        <span class="hero-orbit orbit-two" aria-hidden="true"></span>
                        <p class="team-eyebrow">UNSW Data Science Society</p>
                        <h1>Meet the team</h1>
                        <p class="team-intro">Meet the people behind UNSW DataSoc.</p>
                    </header>

                    <Container class="team-roster max-w-[1440px]">
                        {leadership.map((section, index) => (
                            <section
                                class:list={['team-section space-y-6', `leadership-section leadership-${index}`]}
                                data-trail-section={index === 1 ? '' : undefined}
                                data-team-stop={index === 1 ? 'Executives' : undefined}
                                tabindex={index === 1 ? -1 : undefined}
                            >
                                <h2>{section.title}</h2>
                                <div class="leadership-members">
                                    {section.members.map((member) => {
                                        const image = photo(member.file);
                                        return (
                                            <div class="member-card text-center">
                                                <TeamMemberDetails member={member} image={image} sizes={section.sizes} eager={section.eager} />
                                            </div>
                                        );
                                    })}
                                </div>
                            </section>
                        ))}

                        <section class="team-section directors-section space-y-6" data-trail-section data-team-stop="Directors" tabindex="-1">
                            <h2>Directors</h2>
                            <div class="portfolio-grid">
                                {portfolios.map((section, index) => (
                                    <section class:list={['portfolio-section', `portfolio-${index % PORTFOLIO_VARIANTS}`]}>
                                        <h3>{section.title}</h3>
                                        <div class="portfolio-members">
                                            {section.members.map((member) => {
                                                const image = photo(member.file);
                                                return (
                                                    <div class="member-card text-center">
                                                        <TeamMemberDetails member={member} image={image} sizes={section.sizes} />
                                                    </div>
                                                );
                                            })}
                                        </div>
                                    </section>
                                ))}
                            </div>
                        </section>
                    </Container>
                </main>
            </div>
            <Footer />
        </div>
    </div>
</V2Layout>

<script>
    const TRAIL_CENTER_X = 0.5;
    const TRAIL_RIGHT_X = 0.86;
    const TRAIL_LEFT_X = 0.14;
    const TRAIL_READING_LINE = 0.45;
    // Eighteen bisection steps locate the trail position to well under a pixel.
    const TRAIL_SEARCH_ITERATIONS = 18;
    const page = document.querySelector<HTMLElement>('.team-page');
    const panel = page?.querySelector<HTMLElement>('.team-body');
    const trail = panel?.querySelector<SVGSVGElement>('.scroll-trail');
    const trailBase = trail?.querySelector<SVGPathElement>('.trail-base');
    const trailProgress = trail?.querySelector<SVGPathElement>('.trail-progress');
    const trailDot = trail?.querySelector<SVGCircleElement>('.trail-dot');
    const layers = Array.from(page?.querySelectorAll<HTMLElement>('[data-depth]') ?? []);
    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
    const stopElements = Array.from(page?.querySelectorAll<HTMLElement>('[data-team-stop]') ?? []);
    const railStars = page?.querySelector<HTMLElement>('.rail-stars');
    const stopOffsets = new Map<HTMLElement, number>();
    const refreshStopOffsets = () => {
        stopElements.forEach((element) => stopOffsets.set(element, element.getBoundingClientRect().top + scrollY));
    };
    const layerDocumentCentres = new Map<HTMLElement, number>();
    const refreshLayerCentres = () => {
        layers.forEach((layer) => {
            const rect = layer.getBoundingClientRect();
            const currentOffset = parseFloat(layer.style.getPropertyValue('--parallax-y')) || 0;
            layerDocumentCentres.set(layer, rect.top + scrollY - currentOffset + rect.height / 2);
        });
    };
    const scrollUpdates = new Set<() => void>();
    let scrollFrame = 0;
    const scheduleScrollUpdates = () => {
        if (scrollFrame) return;
        scrollFrame = requestAnimationFrame(() => {
            scrollFrame = 0;
            scrollUpdates.forEach((update) => update());
        });
    };
    const updateParallax = () => {
        if (reducedMotion.matches) {
            layers.forEach((layer) => layer.style.removeProperty('--parallax-y'));
            return;
        }
        layers.forEach((layer) => {
            const speed = Number(layer.dataset.depth) || 0;
            const centre = layerDocumentCentres.get(layer) ?? scrollY;
            const offset = (innerHeight / 2 - centre + scrollY) * speed;
            layer.style.setProperty('--parallax-y', `${offset}px`);
        });
    };
    scrollUpdates.add(updateParallax);
    reducedMotion.addEventListener('change', updateParallax);
    const refreshAndUpdatePositions = () => {
        refreshStopOffsets();
        refreshLayerCentres();
        scheduleScrollUpdates();
    };
    refreshAndUpdatePositions();
    updateParallax();
    addEventListener('load', refreshAndUpdatePositions);
    document.fonts.ready.then(refreshAndUpdatePositions);

    if (page && railStars && stopElements.length) {
        const names = stopElements.map((element) => element.dataset.teamStop ?? 'Section');
        const styles = getComputedStyle(page);
        const colours = ['--team-accent-pink', '--team-accent-purple', '--team-accent-blue'].map((name) =>
            styles.getPropertyValue(name).trim(),
        );
        const stops = stopElements.map((element, index) => {
            const button = railStars.appendChild(document.createElement('button'));
            button.appendChild(document.createElement('i'));
            button.type = 'button';
            button.setAttribute('aria-label', `Go to ${names[index]}`);
            button.style.setProperty('--own-colour', colours[index % colours.length]);
            button.addEventListener('click', () => {
                const scrollMargin = parseFloat(getComputedStyle(element).scrollMarginTop) || 0;
                const top = element.getBoundingClientRect().top + scrollY - scrollMargin;
                element.focus({ preventScroll: true });
                const lenisScroll = new CustomEvent('v2-lenis-scroll-to', {
                    cancelable: true,
                    detail: { top, immediate: reducedMotion.matches },
                });
                if (dispatchEvent(lenisScroll)) {
                    scrollTo({ top, behavior: reducedMotion.matches ? 'auto' : 'smooth' });
                }
            });
            return { element, button };
        });

        const updateStops = () => {
            const readingLine = innerHeight * TRAIL_READING_LINE;
            const atPageBottom = scrollY + innerHeight >= document.documentElement.scrollHeight - 2;
            let current = stops.length - 1;
            if (!atPageBottom) {
                const readingPosition = scrollY + readingLine;
                current = 0;
                for (let index = stops.length - 1; index > 0; index -= 1) {
                    if ((stopOffsets.get(stops[index].element) ?? 0) <= readingPosition) {
                        current = index;
                        break;
                    }
                }
            }
            stops.forEach(({ button }, index) => {
                if (index === current) button.setAttribute('aria-current', 'location');
                else button.removeAttribute('aria-current');
            });
        };

        scrollUpdates.add(updateStops);
        updateStops();
    }

    if (page && panel && trail && trailBase && trailProgress && trailDot) {
        let pathLength = 0;
        let firstY = 0;
        let lastY = 0;
        let drawFrame = 0;

        const drawTrail = () => {
            const bounds = panel.getBoundingClientRect();
            const width = panel.clientWidth;
            const height = panel.scrollHeight;
            trail.setAttribute('viewBox', `0 0 ${width} ${height}`);
            trail.setAttribute('width', String(width));
            trail.setAttribute('height', String(height));

            const anchors = Array.from(panel.querySelectorAll<HTMLElement>('[data-trail-section]'));
            const points = anchors.map((anchor, index) => {
                const heading = anchor.querySelector<HTMLElement>('h1, h2') ?? anchor;
                const rect = heading.getBoundingClientRect();
                return {
                    x: width * (index === 0 ? TRAIL_CENTER_X : index % 2 ? TRAIL_RIGHT_X : TRAIL_LEFT_X),
                    y: rect.top - bounds.top + rect.height / 2,
                };
            });
            firstY = points[0]?.y ?? 0;
            lastY = points.at(-1)?.y ?? firstY;

            const path = points.reduce((data, point, index) => {
                if (index === 0) return `M ${point.x} ${point.y}`;
                const previous = points[index - 1];
                const middleY = (previous.y + point.y) / 2;
                return `${data} C ${previous.x} ${middleY}, ${point.x} ${middleY}, ${point.x} ${point.y}`;
            }, '');

            trailBase.setAttribute('d', path);
            trailProgress.setAttribute('d', path);
            pathLength = trailProgress.getTotalLength();
            trailProgress.style.strokeDasharray = `${pathLength} ${pathLength}`;
            update();
        };

        const update = () => {
            const bounds = panel.getBoundingClientRect();
            if (reducedMotion.matches) {
                trailProgress.style.strokeDashoffset = '0';
                trailDot.setAttribute('visibility', 'hidden');
                return;
            }

            trailDot.removeAttribute('visibility');
            const targetY = Math.min(Math.max(innerHeight * TRAIL_READING_LINE - bounds.top, firstY), lastY);
            let low = 0;
            let high = pathLength;
            for (let i = 0; i < TRAIL_SEARCH_ITERATIONS; i += 1) {
                const middle = (low + high) / 2;
                if (trailProgress.getPointAtLength(middle).y < targetY) low = middle;
                else high = middle;
            }
            const length = (low + high) / 2;
            trailProgress.style.strokeDashoffset = String(pathLength - length);
            const point = trailProgress.getPointAtLength(length);
            trailDot.setAttribute('cx', String(point.x));
            trailDot.setAttribute('cy', String(point.y));
        };

        const scheduleDraw = () => {
            if (drawFrame) return;
            drawFrame = requestAnimationFrame(() => {
                drawFrame = 0;
                drawTrail();
            });
        };

        scrollUpdates.add(update);
        drawTrail();
        addEventListener('resize', scheduleDraw);
        addEventListener('load', scheduleDraw);
        document.fonts.ready.then(scheduleDraw);
        const resizeObserver = new ResizeObserver(scheduleDraw);
        const content = panel.querySelector<HTMLElement>('.team-content');
        if (content) resizeObserver.observe(content);
        reducedMotion.addEventListener('change', scheduleDraw);
    }

    addEventListener('resize', refreshAndUpdatePositions);
    addEventListener('scroll', scheduleScrollUpdates, { passive: true });
    addEventListener('v2-lenis-scroll', scheduleScrollUpdates);
</script>

<style>
    .team-page {
        --team-ink: #34394b;
        --team-cream: #fffcf3;
        --team-blue: #3a718b;
        --team-purple: #776b87;
        --team-accent-pink: #d94a65;
        --team-accent-purple: #8c7898;
        --team-accent-blue: #119bd6;
        --team-accent-gold: #f4b000;
        position: relative;
        isolation: isolate;
        overflow: clip;
        min-height: 100vh;
        padding: 0 clamp(10px, 2.4vw, 38px);
        background:
            radial-gradient(circle, rgb(52 57 75 / 0.18) 1px, transparent 1.5px) 0 0 / 18px 18px,
            linear-gradient(90deg, rgb(217 74 101 / 0.14), transparent 21%, transparent 79%, rgb(58 113 139 / 0.18)),
            linear-gradient(135deg, #e7c5c1 0%, #e0d5e7 33%, #c8dce3 62%, #e9d3bd 100%);
        color: var(--team-ink);
        font-family: var(--font-syne), sans-serif;
    }

    .team-page::before,
    .team-page::after {
        position: absolute;
        inset: 0;
        z-index: -1;
        pointer-events: none;
        content: '';
    }

    .team-page::before {
        background:
            radial-gradient(circle, rgb(52 57 75 / 0.16) 1px, transparent 1.5px) left top / 8vw 18px,
            radial-gradient(circle, rgb(52 57 75 / 0.16) 1px, transparent 1.5px) right top / 8vw 18px;
        background-repeat: repeat-y;
    }

    .team-page::after {
        background:
            radial-gradient(circle at center, transparent 43%, rgb(119 107 135 / 0.34) 44% 45%, transparent 46%) 1vw 12rem / 5rem 5rem no-repeat,
            radial-gradient(circle at center, transparent 43%, rgb(58 113 139 / 0.36) 44% 45%, transparent 46%) calc(100% - 1vw) 42rem / 6rem 6rem no-repeat;
        opacity: 0.6;
    }

    .ambient-background {
        position: absolute;
        inset: 0;
        z-index: -1;
        overflow: hidden;
        pointer-events: none;
    }

    .ambient-cloud {
        position: absolute;
        width: clamp(12rem, 25vw, 27rem);
        aspect-ratio: 1;
        border-radius: 50%;
        filter: blur(8px);
        transform: translate3d(0, var(--parallax-y, 0), 0);
    }

    .cloud-one {
        top: 8%;
        left: -12%;
        background: radial-gradient(circle, rgb(140 120 152 / 0.34), rgb(217 74 101 / 0.18) 52%, transparent 72%);
    }

    .cloud-two {
        top: 45%;
        right: -12%;
        background: radial-gradient(circle, rgb(58 113 139 / 0.34), rgb(217 188 176 / 0.3) 52%, transparent 72%);
    }

    .ambient-sun {
        position: absolute;
        top: 75%;
        left: 0;
        width: 22rem;
        aspect-ratio: 1;
        border-radius: 50%;
        background: radial-gradient(circle, rgb(217 74 101 / 0.2), rgb(244 176 0 / 0.16), transparent 70%);
        transform: translate3d(0, var(--parallax-y, 0), 0);
    }

    .team-panel {
        position: relative;
        width: 100%;
        margin: 0 auto;
        overflow: clip;
        border-right: 1px solid rgb(72 75 112 / 0.12);
        border-left: 1px solid rgb(72 75 112 / 0.12);
        background: var(--team-cream);
        box-shadow: 0 0 3rem rgb(52 57 75 / 0.12);
    }

    .team-body {
        position: relative;
        padding-left: 4.13%;
    }

    .team-content {
        position: relative;
        z-index: 1;
    }

    .scroll-trail {
        position: absolute;
        inset: 0 auto auto 0;
        z-index: 0;
        overflow: visible;
        pointer-events: none;
    }

    .trail-base,
    .trail-progress {
        fill: none;
        stroke: url(#trail-gradient);
        stroke-linecap: round;
    }

    .trail-base {
        stroke-width: 3;
        stroke-dasharray: 2 13;
        opacity: 0.28;
    }

    .trail-progress {
        stroke-width: 4;
        filter: drop-shadow(0 0 4px rgb(119 107 135 / 0.32));
    }

    .trail-dot {
        fill: #fffcf3;
        stroke: var(--team-accent-purple);
        stroke-width: 4;
        filter: drop-shadow(0 0 5px rgb(119 107 135 / 0.4));
    }

    .team-progress-rail {
        position: absolute;
        inset: 0 auto 0 0;
        z-index: 3;
        width: 4.13%;
        overflow: clip;
        background:
            radial-gradient(circle, rgb(255 252 243 / 0.2) 1px, transparent 1.5px) center / 12px 12px,
            #484b70;
        pointer-events: none;
    }

    .rail-track {
        position: absolute;
        inset: -50vh 0;
    }

    .rail-stars {
        position: sticky;
        top: 50vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        transform: translateY(-50%);
    }

    @property --on {
        syntax: '<percentage>';
        inherits: true;
        initial-value: 0%;
    }

    .rail-stars :global(button) {
        display: grid;
        place-items: center;
        width: 100%;
        min-height: 24px;
        padding: 0.295vw 0;
        border: 0;
        background: none;
        cursor: pointer;
        pointer-events: auto;
        --tint: var(--star-colour, var(--own-colour));
        --colour: color-mix(in oklab, var(--tint) var(--on), #fffcf3);
        filter: drop-shadow(0 0 0.25vw color-mix(in oklab, var(--tint) var(--on), transparent));
        transition: --on 150ms ease;
    }

    .rail-stars :global(button[aria-current]) {
        --on: 100%;
        transition-duration: 250ms;
    }

    .rail-stars :global(button:not([aria-current]):hover) {
        --on: 50%;
    }

    @media (prefers-reduced-motion: reduce) {
        .rail-stars :global(button) {
            transition: none;
        }
    }

    .rail-stars :global(button:focus-visible) {
        outline: 2px solid #fffcf3;
        outline-offset: -2px;
    }

    .rail-stars :global(i) {
        display: block;
        width: 1.17vw;
        height: 1.17vw;
        background: var(--colour);
        mask: var(--star) -0.756vw -0.549vw / 2.8vw no-repeat;
    }

    .team-hero {
        position: relative;
        isolation: isolate;
        overflow: hidden;
        padding: clamp(2rem, 3.5vw, 3rem) 1.5rem;
        text-align: center;
        background:
            radial-gradient(ellipse at 18% 0%, rgb(217 74 101 / 0.1), transparent 42%),
            radial-gradient(ellipse at 92% 100%, rgb(119 107 135 / 0.12), transparent 44%),
            radial-gradient(ellipse at 70% 30%, rgb(58 113 139 / 0.1), transparent 36%),
            linear-gradient(110deg, #f2e9e3, #fffcf3);
    }

    .team-hero::before {
        position: absolute;
        inset: 0;
        z-index: -1;
        background: radial-gradient(circle, rgb(52 57 75 / 0.11) 1px, transparent 1.6px) 50% 50% / 19px 19px;
        mask-image: linear-gradient(90deg, #000, transparent 20%, transparent 80%, #000);
        content: '';
    }

    .team-hero::after {
        position: absolute;
        inset: auto 0 0;
        z-index: -1;
        height: 1px;
        background: linear-gradient(90deg, transparent, var(--team-accent-pink), var(--team-accent-purple), var(--team-accent-blue), transparent);
        content: '';
    }

    .hero-cloud {
        position: absolute;
        z-index: -1;
        width: clamp(8rem, 16vw, 13rem);
        aspect-ratio: 1;
        border-radius: 50%;
        filter: blur(7px);
        transform: translate3d(0, var(--parallax-y, 0), 0);
    }

    .cloud-left {
        top: -60%;
        left: 7%;
        background: radial-gradient(circle, rgb(140 120 152 / 0.28), transparent 70%);
    }

    .cloud-right {
        right: 6%;
        bottom: -75%;
        background: radial-gradient(circle, rgb(58 113 139 / 0.26), rgb(217 74 101 / 0.16), transparent 70%);
    }

    .hero-orbit {
        position: absolute;
        z-index: -1;
        width: clamp(3rem, 8vw, 6.5rem);
        aspect-ratio: 1;
        border: 1px solid rgb(52 57 75 / 0.2);
        border-radius: 50%;
    }

    .orbit-one {
        top: 15%;
        left: 21%;
    }

    .orbit-two {
        right: 20%;
        bottom: 12%;
        width: clamp(2rem, 5vw, 4rem);
        border-style: dashed;
    }


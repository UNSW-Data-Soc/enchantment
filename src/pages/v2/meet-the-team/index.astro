---
import Container from '../../../components/Container.astro';
import Footer from '../../../components/v2/Footer.astro';
import V2Layout from '../../../layouts/V2Layout.astro';
import star from '../../../assets/ui/shapes/one-star.svg?url';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

const photos = import.meta.glob<{ default: ImageMetadata }>(
    '../../../assets/meet-the-team/datasoc-board-photos/*.jpg',
    { eager: true },
);

function photo(file?: string): ImageMetadata | undefined {
    if (!file) return undefined;
    const entry = photos[`../../../assets/meet-the-team/datasoc-board-photos/${file}`];
    if (!entry) throw new Error(`Board photo not found: ${file}`);
    return entry.default;
}

const IMAGE_WIDTHS = [240, 380, 540, 700];

type Member = { name: string; role: string; file?: string };
type Section = {
    title: string;
    cardClass: string;
    sizes: string;
    eager?: boolean;
    members: Member[];
};

const leadership: Section[] = [
    {
        title: 'President',
        cardClass: 'w-[70%] sm:w-[50%] md:w-[32%] lg:w-[24%]',
        sizes: '(min-width: 1024px) 276px, (min-width: 768px) 32vw, (min-width: 640px) 50vw, 70vw',
        eager: true,
        members: [{ name: 'Qingyuan He', role: 'President', file: 'qingyuan_h.jpg' }],
    },
    {
        title: 'Executives',
        cardClass: 'w-[42%] sm:w-[38%] md:w-[28%] lg:w-[22%]',
        sizes: '(min-width: 1024px) 253px, (min-width: 768px) 28vw, (min-width: 640px) 38vw, 42vw',
        members: [
            { name: 'Ethan Pham', role: 'Vice President (Activities)', file: 'ethan_p.jpg' },
            { name: 'Stella Lin', role: 'Vice President (Development)', file: 'stella_l.jpg' },
            { name: 'Naisha Kulshreshtha', role: 'Vice President (External)' },
            { name: 'Andre Baruah', role: 'Vice President (Operations)', file: 'andre_b.jpg' },
            { name: 'Akhil Panwar', role: 'Secretary', file: 'akhil_p.jpg' },
            { name: 'Aaron Chen', role: 'Treasurer' },
        ],
    },
];

const directors: Member[] = [
    { name: 'Aaron Wong', role: 'Human Resources Director' },
    { name: 'Yatha Shah', role: 'Human Resources Director', file: 'yatha_s.jpg' },
    { name: 'Linh Pham', role: 'Social Director', file: 'linh_p.jpg' },
    { name: 'Jason Nguyen', role: 'Social Director' },
    { name: 'Lily Tang', role: 'Education Director', file: 'lily_t.jpg' },
    { name: 'Minjun Kim', role: 'Education Director', file: 'minjun_k.jpg' },
    { name: 'Anoushka Pandey', role: 'Philanthropy & Projects Director', file: 'anoushka_p.jpg' },
    { name: 'Isabella Fan', role: 'Philanthropy & Projects Director', file: 'isabella_f.jpg' },
    { name: 'Liam Lightfoot', role: 'Careers Director' },
    { name: 'Vidisha Trivedi', role: 'Careers Director', file: 'vidisha_t.jpg' },
    { name: 'Cathy Dinh', role: 'Sponsorships Director', file: 'cathy_d.jpg' },
    { name: 'Simon Shen', role: 'Sponsorships Director' },
    { name: 'Kai Lu', role: 'Technology Director', file: 'kai_l.jpg' },
    { name: 'Shafquat Tabeeb', role: 'Technology Director', file: 'shafquat_t.jpg' },
    { name: 'Jennifer Lee', role: 'Marketing Director', file: 'jennifer_l.jpg' },
    { name: 'Shashwat Manish', role: 'Marketing Director' },
    { name: 'Shreya Verma', role: 'Media Director', file: 'shreya_v.jpg' },
    { name: 'Vedant Tyagi', role: 'Media Director', file: 'vedant_t.jpg' },
];

const portfolios = Array.from(
    directors.reduce((groups, member) => {
        const title = member.role.replace(/ Director$/, '');
        const members = groups.get(title) ?? [];
        members.push(member);
        groups.set(title, members);
        return groups;
    }, new Map<string, Member[]>()),
    ([title, members]) => ({
        title,
        cardClass: 'w-[42%] md:w-[28%] lg:w-[22%]',
        sizes: '(min-width: 1024px) 253px, (min-width: 768px) 28vw, 42vw',
        members,
    }),
);
---

<V2Layout title="Meet the team - UNSW Data Science Society">
    <main class="team-page">
        <div class="ambient-background" aria-hidden="true">
            <span class="ambient-cloud cloud-one" data-depth="0.06"></span>
            <span class="ambient-cloud cloud-two" data-depth="0.1"></span>
            <span class="ambient-sun" data-depth="0.035"></span>
        </div>

        <div class="team-panel">
            <div class="team-body">
                <svg class="scroll-trail" aria-hidden="true" preserveAspectRatio="none">
                    <defs>
                        <linearGradient id="trail-gradient" x1="0" y1="0" x2="0" y2="1">
                            <stop offset="0%" stop-color="#ee547d" />
                            <stop offset="48%" stop-color="#8558d8" />
                            <stop offset="100%" stop-color="#119bd6" />
                        </linearGradient>
                    </defs>
                    <path class="trail-base" />
                    <path class="trail-progress" />
                    <circle class="trail-dot" r="8" />
                </svg>

                <aside class="team-progress-rail" aria-label="Page sections" style={`--star: url("${star}")`}>
                    <div class="rail-track">
                        <div class="rail-stars"></div>
                    </div>
                </aside>

                <div class="team-content">
                    <header class="team-hero" data-team-stop="Meet the team & President">
                        <span class="hero-cloud cloud-left" data-depth="0.12" aria-hidden="true"></span>
                        <span class="hero-cloud cloud-right" data-depth="0.08" aria-hidden="true"></span>
                        <span class="hero-orbit orbit-one" aria-hidden="true"></span>
                        <span class="hero-orbit orbit-two" aria-hidden="true"></span>
                        <span class="hero-pixel pixel-one" aria-hidden="true"></span>
                        <span class="hero-pixel pixel-two" aria-hidden="true"></span>
                        <span class="hero-diamond" aria-hidden="true"></span>
                        <p class="team-eyebrow">UNSW Data Science Society</p>
                        <h1>Meet the team</h1>
                        <p class="team-intro">Meet the people behind UNSW DataSoc.</p>
                    </header>

                    <Container class="team-roster max-w-[1440px]">
                        {leadership.map((section, index) => (
                            <section
                                class:list={['team-section space-y-6', `leadership-section leadership-${index}`]}
                                data-trail-section
                            >
                                <h2>{section.title}</h2>
                                <div class="leadership-members">
                                    {section.members.map((member) => {
                                        const image = photo(member.file);
                                        return (
                                            <div class:list={['member-card text-center', section.cardClass]}>
                                                {image ? (
                                                    <Image src={image} alt={member.name} widths={IMAGE_WIDTHS} sizes={section.sizes} loading={section.eager ? 'eager' : 'lazy'} class="member-photo w-full object-cover" />
                                                ) : (
                                                    <div class="member-photo photo-placeholder w-full flex items-center justify-center" role="img" aria-label={`${member.name} photo unavailable`}>
                                                        <span aria-hidden="true">Photo unavailable</span>
                                                    </div>
                                                )}
                                                <p class="member-name">{member.name}</p>
                                                <p class="member-role">{member.role}</p>
                                            </div>
                                        );
                                    })}
                                </div>
                            </section>
                        ))}

                        <section class="team-section directors-section space-y-6" data-trail-section data-team-stop="Directors">
                            <h2>Directors</h2>
                            <div class="portfolio-grid">
                                {portfolios.map((section, index) => (
                                    <section class:list={['portfolio-section', `portfolio-${index % 4}`]}>
                                        <h3>{section.title}</h3>
                                        <div class="portfolio-members">
                                            {section.members.map((member) => {
                                                const image = photo(member.file);
                                                return (
                                                    <div class:list={['member-card text-center', section.cardClass]}>
                                                        {image ? (
                                                            <Image src={image} alt={member.name} widths={IMAGE_WIDTHS} sizes={section.sizes} loading="lazy" class="member-photo w-full object-cover" />
                                                        ) : (
                                                            <div class="member-photo photo-placeholder w-full flex items-center justify-center" role="img" aria-label={`${member.name} photo unavailable`}>
                                                                <span aria-hidden="true">Photo unavailable</span>
                                                            </div>
                                                        )}
                                                        <p class="member-name">{member.name}</p>
                                                        <p class="member-role">{member.role}</p>
                                                    </div>
                                                );
                                            })}
                                        </div>
                                    </section>
                                ))}
                            </div>
                        </section>
                    </Container>
                </div>
            </div>
            <Footer />
        </div>
    </main>
</V2Layout>

<script>
    const TRAIL_CENTER_X = 0.5;
    const TRAIL_RIGHT_X = 0.86;
    const TRAIL_LEFT_X = 0.14;
    const TRAIL_READING_LINE = 0.45;
    // Eighteen bisection steps locate the trail position to well under a pixel.
    const TRAIL_SEARCH_ITERATIONS = 18;
    const page = document.querySelector<HTMLElement>('.team-page');
    const panel = page?.querySelector<HTMLElement>('.team-body');
    const trail = panel?.querySelector<SVGSVGElement>('.scroll-trail');
    const trailBase = trail?.querySelector<SVGPathElement>('.trail-base');
    const trailProgress = trail?.querySelector<SVGPathElement>('.trail-progress');
    const trailDot = trail?.querySelector<SVGCircleElement>('.trail-dot');
    const layers = Array.from(document.querySelectorAll<HTMLElement>('[data-depth]'));
    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
    const stopElements = Array.from(page?.querySelectorAll<HTMLElement>('[data-team-stop]') ?? []);
    const railStars = page?.querySelector<HTMLElement>('.rail-stars');

    if (railStars && stopElements.length) {
        const names = stopElements.map((element) => element.dataset.teamStop ?? 'Section');
        const colours = ['#ee547d', '#8558d8', '#119bd6'];
        const stops = stopElements.map((element, index) => {
            const button = railStars.appendChild(document.createElement('button'));
            button.appendChild(document.createElement('i'));
            button.type = 'button';
            button.setAttribute('aria-label', `Go to ${names[index]}`);
            button.style.setProperty('--own-colour', colours[index % colours.length]);
            button.addEventListener('click', () => {
                const top = element.getBoundingClientRect().top + scrollY - 88;
                scrollTo({ top, behavior: reducedMotion.matches ? 'instant' : 'smooth' });
            });
            return { element, button, icon };
        });

        const updateStops = () => {
            const readingLine = innerHeight * 0.42;
            const current = Math.max(
                stops.findLastIndex(({ element }) => element.getBoundingClientRect().top <= readingLine),
                0,
            );
            stops.forEach(({ button }, index) => {
                if (index === current) button.setAttribute('aria-current', 'location');
                else button.removeAttribute('aria-current');
            });
        };

        let stopFrame = 0;
        const scheduleStops = () => {
            if (stopFrame) return;
            stopFrame = requestAnimationFrame(() => {
                stopFrame = 0;
                updateStops();
            });
        };
        updateStops();
        addEventListener('scroll', scheduleStops, { passive: true });
        addEventListener('v2-lenis-scroll', scheduleStops);
        addEventListener('resize', scheduleStops);
    }

    if (page && panel && trail && trailBase && trailProgress && trailDot) {
        let pathLength = 0;
        let firstY = 0;
        let lastY = 0;
        let frame = 0;
        let drawFrame = 0;
        const layerDocumentCentres = new Map<HTMLElement, number>();

        const drawTrail = () => {
            const bounds = panel.getBoundingClientRect();
            const width = panel.clientWidth;
            const height = panel.scrollHeight;
            trail.setAttribute('viewBox', `0 0 ${width} ${height}`);
            trail.setAttribute('width', String(width));
            trail.setAttribute('height', String(height));

            layers.forEach((layer) => {
                const rect = layer.getBoundingClientRect();
                const currentOffset = parseFloat(layer.style.getPropertyValue('--parallax-y')) || 0;
                layerDocumentCentres.set(layer, rect.top + scrollY - currentOffset + rect.height / 2);
            });

            const anchors = Array.from(panel.querySelectorAll<HTMLElement>('[data-trail-section]'));
            const points = anchors.map((anchor, index) => {
                const heading = anchor.querySelector<HTMLElement>('h1, h2') ?? anchor;
                const rect = heading.getBoundingClientRect();
                return {
                    x: width * (index === 0 ? TRAIL_CENTER_X : index % 2 ? TRAIL_RIGHT_X : TRAIL_LEFT_X),
                    y: rect.top - bounds.top + rect.height / 2,
                };
            });
            firstY = points[0]?.y ?? 0;
            lastY = points.at(-1)?.y ?? firstY;

            const path = points.reduce((data, point, index) => {
                if (index === 0) return `M ${point.x} ${point.y}`;
                const previous = points[index - 1];
                const middleY = (previous.y + point.y) / 2;
                return `${data} C ${previous.x} ${middleY}, ${point.x} ${middleY}, ${point.x} ${point.y}`;
            }, '');

            trailBase.setAttribute('d', path);
            trailProgress.setAttribute('d', path);
            pathLength = trailProgress.getTotalLength();
            trailProgress.style.strokeDasharray = `${pathLength} ${pathLength}`;
            update();
        };

        const update = () => {
            frame = 0;
            const bounds = panel.getBoundingClientRect();
            if (reducedMotion.matches) {
                trailProgress.style.strokeDashoffset = '0';
                trailDot.setAttribute('visibility', 'hidden');
                layers.forEach((layer) => layer.style.removeProperty('--parallax-y'));
                return;
            }

            trailDot.removeAttribute('visibility');
            const targetY = Math.min(Math.max(innerHeight * TRAIL_READING_LINE - bounds.top, firstY), lastY);
            let low = 0;
            let high = pathLength;
            for (let i = 0; i < TRAIL_SEARCH_ITERATIONS; i += 1) {
                const middle = (low + high) / 2;
                if (trailProgress.getPointAtLength(middle).y < targetY) low = middle;
                else high = middle;
            }
            const length = (low + high) / 2;
            trailProgress.style.strokeDashoffset = String(pathLength - length);
            const point = trailProgress.getPointAtLength(length);
            trailDot.setAttribute('cx', String(point.x));
            trailDot.setAttribute('cy', String(point.y));

            const layerOffsets = layers.map((layer) => {
                const speed = Number(layer.dataset.depth) || 0;
                const centre = layerDocumentCentres.get(layer) ?? scrollY;
                return (innerHeight / 2 - centre + scrollY) * speed;
            });
            layers.forEach((layer, index) => layer.style.setProperty('--parallax-y', `${layerOffsets[index]}px`));
        };

        const schedule = () => {
            if (!frame) frame = requestAnimationFrame(update);
        };

        const scheduleDraw = () => {
            if (drawFrame) return;
            drawFrame = requestAnimationFrame(() => {
                drawFrame = 0;
                drawTrail();
            });
        };

        drawTrail();
        addEventListener('scroll', schedule, { passive: true });
        addEventListener('v2-lenis-scroll', schedule);
        addEventListener('resize', scheduleDraw);
        addEventListener('load', scheduleDraw);
        document.fonts.ready.then(scheduleDraw);
        const resizeObserver = new ResizeObserver(scheduleDraw);
        const content = panel.querySelector<HTMLElement>('.team-content');
        if (content) resizeObserver.observe(content);
        reducedMotion.addEventListener('change', schedule);
    }
</script>

<style>
    .team-page {
        --team-ink: #484b70;
        --team-cream: #fffcf3;
        --team-blue: #087fae;
        --team-purple: #7450cb;
        position: relative;
        isolation: isolate;
        overflow: clip;
        min-height: 100vh;
        padding: 0 clamp(10px, 2.4vw, 38px);
        background:
            radial-gradient(circle, rgb(72 75 112 / 0.32) 1.2px, transparent 1.8px) 0 0 / 19px 19px,
            linear-gradient(90deg, rgb(17 155 214 / 0.3), transparent 24%, transparent 76%, rgb(133 88 216 / 0.32)),
            linear-gradient(135deg, #f1a4bc 0%, #d0b3ed 32%, #a9d8f1 57%, #f4b8a2 78%, #f7d47f 100%);
        color: var(--team-ink);
        font-family: var(--font-syne), sans-serif;
    }

    .team-page::before,
    .team-page::after {
        position: absolute;
        inset: 0;
        z-index: -1;
        pointer-events: none;
        content: '';
    }

    .team-page::before {
        background:
            repeating-linear-gradient(135deg, transparent 0 17px, rgb(72 75 112 / 0.08) 18px 20px, transparent 21px 39px) left top / 8vw 100%,
            repeating-linear-gradient(45deg, transparent 0 17px, rgb(72 75 112 / 0.08) 18px 20px, transparent 21px 39px) right top / 8vw 100%;
        background-repeat: repeat-y;
    }

    .team-page::after {
        background:
            radial-gradient(circle at center, transparent 42%, rgb(116 80 203 / 0.36) 43% 45%, transparent 46%) 1vw 13rem / 5rem 5rem no-repeat,
            radial-gradient(circle at center, transparent 38%, rgb(17 155 214 / 0.42) 39% 42%, transparent 43%) calc(100% - 1vw) 44rem / 6rem 6rem no-repeat,
            conic-gradient(from 45deg, #ee547d 0 25%, #8558d8 0 50%, #119bd6 0 75%, #f4b000 0) 0 0 / 1.1rem 1.1rem no-repeat,
            conic-gradient(from 45deg, #ee547d 0 25%, #8558d8 0 50%, #119bd6 0 75%, #f4b000 0) calc(100% - 1vw) 82rem / 0.8rem 0.8rem no-repeat;
        mask-image: linear-gradient(90deg, #000 0, transparent 10%, transparent 90%, #000 100%);
        opacity: 0.7;
    }

    .ambient-background {
        position: absolute;
        inset: 0;
        z-index: -1;
        overflow: hidden;
        pointer-events: none;
    }

    .ambient-cloud {
        position: absolute;
        width: clamp(12rem, 29vw, 30rem);
        aspect-ratio: 1;
        border-radius: 50%;
        filter: blur(3px);
        transform: translate3d(0, var(--parallax-y, 0), 0);
    }

    .cloud-one {
        top: 8%;
        left: -12%;
        background: radial-gradient(circle, rgb(123 101 224 / 0.6), rgb(245 138 151 / 0.36) 52%, transparent 72%);
    }

    .cloud-two {
        top: 45%;
        right: -12%;
        background: radial-gradient(circle, rgb(97 183 234 / 0.72), rgb(232 139 157 / 0.38) 52%, transparent 72%);
    }

    .ambient-sun {
        position: absolute;
        top: 75%;
        left: 0;
        width: 22rem;
        aspect-ratio: 1;
        border-radius: 50%;
        background: radial-gradient(circle, rgb(242 155 192 / 0.78), rgb(255 224 158 / 0.5), transparent 70%);
        transform: translate3d(0, var(--parallax-y, 0), 0);
    }

    .team-panel {
        position: relative;
        width: 100%;
        margin: 0 auto;
        overflow: hidden;
        border-right: 1px solid rgb(72 75 112 / 0.12);
        border-left: 1px solid rgb(72 75 112 / 0.12);
        background: var(--team-cream);
        box-shadow: 0 0 4rem rgb(72 47 65 / 0.19);
    }

    .team-body {
        position: relative;
        padding-left: clamp(2.25rem, 4.4vw, 4.25rem);
    }

    .team-content {
        position: relative;
        z-index: 1;
    }

    .scroll-trail {
        position: absolute;
        inset: 0 auto auto 0;
        z-index: 0;
        overflow: visible;
        pointer-events: none;
    }

    .trail-base,
    .trail-progress {
        fill: none;
        stroke: url(#trail-gradient);
        stroke-linecap: round;
    }

    .trail-base {
        stroke-width: 3;
        stroke-dasharray: 2 13;
        opacity: 0.28;
    }

    .trail-progress {
        stroke-width: 4;
        filter: drop-shadow(0 0 5px rgb(133 88 216 / 0.5));
    }

    .trail-dot {
        fill: #fffcf3;
        stroke: #8558d8;
        stroke-width: 4;
        filter: drop-shadow(0 0 7px rgb(133 88 216 / 0.65));
    }

    .team-progress-rail {
        position: absolute;
        inset: 0 auto 0 0;
        z-index: 3;
        width: clamp(2.25rem, 4.4vw, 4.25rem);
        overflow: clip;
        background:
            radial-gradient(circle, rgb(255 252 243 / 0.42) 1px, transparent 1.6px) center / 11px 11px,
            linear-gradient(180deg, #484b70, #7450cb 48%, #087fae);
        pointer-events: none;
    }

    .rail-track {
        position: absolute;
        inset: -50vh 0;
    }

    .rail-stars {
        position: sticky;
        top: 50vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        transform: translateY(-50%);
    }

    .rail-stars :global(button) {
        display: grid;
        place-items: center;
        width: 100%;
        min-height: 42px;
        padding: 0.45rem 0;
        border: 0;
        background: none;
        cursor: pointer;
        pointer-events: auto;
        --star-tint: var(--star-colour, var(--own-colour, #fffcf3));
        filter: drop-shadow(0 0 0.3rem color-mix(in oklab, var(--star-tint) 65%, transparent));
        transition: filter 180ms ease;
    }

    .rail-stars :global(button[aria-current]) {
        --star-colour: var(--own-colour);
        transform: scale(1.14);
    }

    .rail-stars :global(button:focus-visible) {
        outline: 2px solid #fffcf3;
        outline-offset: -4px;
    }

    .rail-stars :global(i) {
        display: block;
        width: 1.35rem;
        height: 1.35rem;
        background: var(--star-tint);
        mask: var(--star) center / contain no-repeat;
    }

    .team-hero {
        position: relative;
        isolation: isolate;
        overflow: hidden;
        padding: clamp(2rem, 3.5vw, 3rem) 1.5rem;
        text-align: center;
        background:
            radial-gradient(ellipse at 20% 0%, rgb(238 84 125 / 0.24), transparent 42%),
            radial-gradient(ellipse at 90% 100%, rgb(127 93 218 / 0.27), transparent 44%),
            radial-gradient(ellipse at 70% 30%, rgb(17 155 214 / 0.16), transparent 36%),
            linear-gradient(110deg, #f3e9e6, #fefbf0);
    }

    .team-hero::before {
        position: absolute;
        inset: 0;
        z-index: -1;
        background: radial-gradient(circle, rgb(72 75 112 / 0.2) 1px, transparent 1.6px) 50% 50% / 15px 15px;
        mask-image: linear-gradient(90deg, #000, transparent 28%, transparent 72%, #000);
        content: '';
    }

    .team-hero::after {
        position: absolute;
        inset: auto 0 0;
        z-index: -1;
        height: 0.35rem;
        background: linear-gradient(90deg, #ee547d, #8558d8, #119bd6, #f4b000);
        content: '';
    }

    .hero-cloud {
        position: absolute;
        z-index: -1;
        width: clamp(8rem, 19vw, 15rem);
        aspect-ratio: 1;
        border-radius: 50%;
        filter: blur(2px);
        transform: translate3d(0, var(--parallax-y, 0), 0);
    }

    .cloud-left {
        top: -60%;
        left: 7%;
        background: radial-gradient(circle, rgb(133 88 216 / 0.38), transparent 70%);
    }

    .cloud-right {
        right: 6%;
        bottom: -75%;
        background: radial-gradient(circle, rgb(17 155 214 / 0.34), rgb(255 84 125 / 0.28), transparent 70%);
    }

    .hero-orbit {
        position: absolute;
        z-index: -1;
        width: clamp(3rem, 8vw, 6.5rem);
        aspect-ratio: 1;
        border: 1px solid rgb(72 75 112 / 0.25);
        border-radius: 50%;
    }

    .orbit-one {
        top: 15%;
        left: 21%;
    }

    .orbit-two {
        right: 20%;
        bottom: 12%;
        width: clamp(2rem, 5vw, 4rem);
        border-style: dashed;
    }

    .hero-pixel {
        position: absolute;
        z-index: -1;
        width: 0.65rem;
        aspect-ratio: 1;
        background: #ee8796;
        box-shadow: 0.9rem 0.7rem 0 #ffe3a6, 1.8rem -0.2rem 0 #c3ffff;
        transform: rotate(15deg);
    }

    .pixel-one {

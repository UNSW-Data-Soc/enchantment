---
import Container from '../../../components/Container.astro';
import Footer from '../../../components/v2/Footer.astro';
import StarsScrollbar from '../../../components/v2/StarsScrollbar.astro';
import TeamMemberDetails from '../../../components/v2/TeamMemberDetails.astro';
import V2Layout from '../../../layouts/V2Layout.astro';
import type { ImageMetadata } from 'astro';

const LEADERSHIP_SIZES = '(min-width: 1440px) 250px, (min-width: 768px) 22vw, (min-width: 640px) 150px, 42vw';
const PORTFOLIO_SIZES = LEADERSHIP_SIZES;
const PORTFOLIO_VARIANTS = 4;
const MATRIX_COLUMNS = 12;
const MATRIX_ROWS = 10;
const MATRIX_HUES = [205, 218, 232, 250, 270, 292, 315, 340, 5, 25, 43, 55];
const CARD_PARALLAX_DEPTHS = [0.04, -0.045, 0.028, -0.035, 0.05, -0.025];
const photos = import.meta.glob<{ default: ImageMetadata }>(
    '../../../assets/meet-the-team/datasoc-board-photos/*.jpg',
    { eager: true },
);

function photo(file?: string): ImageMetadata | undefined {
    if (!file) return undefined;
    const entry = photos[`../../../assets/meet-the-team/datasoc-board-photos/${file}`];
    if (!entry) throw new Error(`Board photo not found: ${file}`);
    return entry.default;
}

function cardDepth(index: number): number {
    return CARD_PARALLAX_DEPTHS[index % CARD_PARALLAX_DEPTHS.length];
}

const matrixCells = Array.from({ length: MATRIX_COLUMNS * MATRIX_ROWS }, (_, index) => {
    const x = index % MATRIX_COLUMNS;
    const y = Math.floor(index / MATRIX_COLUMNS);
    const hue = MATRIX_HUES[x];
    const opacity = Number((0.16 + (x / (MATRIX_COLUMNS - 1)) * 0.26 + ((x + y) % 4) * 0.045).toFixed(2));
    return { x, y, hue, opacity };
});

const currentYear = new Date().getFullYear();

type Member = { name: string; role: string; file?: string };
type Section = {
    title: string;
    sizes: string;
    eager?: boolean;
    members: Member[];
};

const leadership: Section[] = [
    {
        title: 'President',
        sizes: LEADERSHIP_SIZES,
        eager: true,
        members: [{ name: 'Qingyuan He', role: 'President', file: 'qingyuan_h.jpg' }],
    },
    {
        title: 'Executives',
        sizes: LEADERSHIP_SIZES,
        members: [
            { name: 'Ethan Pham', role: 'Vice President (Activities)', file: 'ethan_p.jpg' },
            { name: 'Stella Lin', role: 'Vice President (Development)', file: 'stella_l.jpg' },
            { name: 'Naisha Kulshreshtha', role: 'Vice President (External)' },
            { name: 'Andre Baruah', role: 'Vice President (Operations)', file: 'andre_b.jpg' },
            { name: 'Akhil Panwar', role: 'Secretary', file: 'akhil_p.jpg' },
            { name: 'Aaron Chen', role: 'Treasurer' },
        ],
    },
];

const directors: Member[] = [
    { name: 'Aaron Wong', role: 'Human Resources Director' },
    { name: 'Yatha Shah', role: 'Human Resources Director', file: 'yatha_s.jpg' },
    { name: 'Linh Pham', role: 'Social Director', file: 'linh_p.jpg' },
    { name: 'Jason Nguyen', role: 'Social Director' },
    { name: 'Lily Tang', role: 'Education Director', file: 'lily_t.jpg' },
    { name: 'Minjun Kim', role: 'Education Director', file: 'minjun_k.jpg' },
    { name: 'Anoushka Pandey', role: 'Philanthropy & Projects Director', file: 'anoushka_p.jpg' },
    { name: 'Isabella Fan', role: 'Philanthropy & Projects Director', file: 'isabella_f.jpg' },
    { name: 'Liam Lightfoot', role: 'Careers Director' },
    { name: 'Vidisha Trivedi', role: 'Careers Director', file: 'vidisha_t.jpg' },
    { name: 'Cathy Dinh', role: 'Sponsorships Director', file: 'cathy_d.jpg' },
    { name: 'Simon Shen', role: 'Sponsorships Director' },
    { name: 'Kai Lu', role: 'Technology Director', file: 'kai_l.jpg' },
    { name: 'Shafquat Tabeeb', role: 'Technology Director', file: 'shafquat_t.jpg' },
    { name: 'Jennifer Lee', role: 'Marketing Director', file: 'jennifer_l.jpg' },
    { name: 'Shashwat Manish', role: 'Marketing Director' },
    { name: 'Shreya Verma', role: 'Media Director', file: 'shreya_v.jpg' },
    { name: 'Vedant Tyagi', role: 'Media Director', file: 'vedant_t.jpg' },
];

const portfolios = Array.from(
    directors.reduce((groups, member) => {
        const title = member.role.replace(/ Director$/, '');
        const members = groups.get(title) ?? [];
        members.push(member);
        groups.set(title, members);
        return groups;
    }, new Map<string, Member[]>()),
    ([title, members]) => ({
        title,
        sizes: PORTFOLIO_SIZES,
        members,
    }),
);
---

<V2Layout title="Meet the team - UNSW DataSoc">
    <div class="team-page">
        <div class="ambient-background" aria-hidden="true">
            <span class="ambient-cloud cloud-one" data-depth="0.06"></span>
            <span class="ambient-cloud cloud-two" data-depth="0.1"></span>
            <span class="ambient-sun" data-depth="0.035"></span>
            <span class="side-geometry geometry-left-one" data-depth="0.025"></span>
            <span class="side-geometry geometry-right-one" data-depth="0.04"></span>
            <span class="side-geometry geometry-left-two" data-depth="0.035"></span>
            <span class="side-geometry geometry-right-two" data-depth="0.025"></span>
        </div>

        <svg class="scroll-trail" aria-hidden="true" preserveAspectRatio="none">
            <defs>
                <linearGradient id="trail-gradient" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0%" stop-color="var(--team-accent-pink)" />
                    <stop offset="48%" stop-color="var(--team-accent-purple)" />
                    <stop offset="100%" stop-color="var(--team-accent-blue)" />
                </linearGradient>
            </defs>
            <path class="trail-base" />
            <path class="trail-progress" />
            <circle class="trail-dot" r="8" />
        </svg>

        <StarsScrollbar length="100%" />

        <div class="team-panel">
            <div class="team-body">
                <main
                    class="team-content"
                    data-trail-section
                    data-section="Meet the team & President"
                    data-team-stop="Meet the team & President"
                    tabindex="-1"
                >
                    <header class="team-hero">
                        <div class="hero-copy">
                            <p class="team-eyebrow"><span>UNSW DataSoc</span><span>—</span><span>People &amp; portfolios</span></p>
                            <h1>Meet the <em>team</em></h1>
                            <p class="team-intro">The people shaping our year, our community, and what comes next.</p>
                            <p class="hero-index">BOARD {currentYear} <span>✳</span> UNSW</p>
                        </div>
                        <div class="hero-art" aria-hidden="true">
                            <div class="hero-matrix">
                                {matrixCells.map(({ x, y, hue, opacity }) => (
                                    <span
                                        class="matrix-cell"
                                        data-x={x}
                                        data-y={y}
                                        data-opacity={opacity}
                                        style={`--cell-hue:${hue}; --cell-opacity:${opacity}`}
                                    ></span>
                                ))}
                            </div>
                        </div>
                    </header>

                    <Container class="team-roster max-w-[1440px]">
                        {leadership.map((section, index) => (
                            <section
                                class:list={['team-section space-y-12', `leadership-section leadership-${index}`]}
                                data-trail-section={index === 1 ? '' : undefined}
                                data-section={index === 1 ? 'Executives' : undefined}
                                data-team-stop={index === 1 ? 'Executives' : undefined}
                                tabindex={index === 1 ? -1 : undefined}
                            >
                                <h2>{section.title}</h2>
                                <div class="leadership-members">
                                    {section.members.map((member, memberIndex) => {
                                        const image = photo(member.file);
                                        return (
                                            <div class="member-card text-center" data-depth={cardDepth(memberIndex + index)}>
                                                <TeamMemberDetails member={member} image={image} sizes={section.sizes} eager={section.eager} />
                                            </div>
                                        );
                                    })}
                                </div>
                            </section>
                        ))}

                        <section class="team-section directors-section space-y-12" data-trail-section data-section="Directors" data-team-stop="Directors" tabindex="-1">
                            <h2>Directors</h2>
                            <div class="portfolio-grid">
                                {portfolios.map((section, index) => (
                                    <section class:list={['portfolio-section', `portfolio-${index % PORTFOLIO_VARIANTS}`]} data-trail-section>
                                        <h3>{section.title}</h3>
                                        <div class="portfolio-members">
                                            {section.members.map((member, memberIndex) => {
                                                const image = photo(member.file);
                                                return (
                                                    <div class="member-card text-center" data-depth={cardDepth(memberIndex + index + 2)}>
                                                        <TeamMemberDetails member={member} image={image} sizes={section.sizes} />
                                                    </div>
                                                );
                                            })}
                                        </div>
                                    </section>
                                ))}
                            </div>
                        </section>
                    </Container>
                </main>
            </div>
        </div>
        <div class="rail-tail-space" aria-hidden="true"></div>
    </div>
    <div class="team-footer">
        <Footer />
    </div>
</V2Layout>

<script>
    const TRAIL_CENTER_X = 0.5;
    const TRAIL_RIGHT_X = 0.86;
    const TRAIL_LEFT_X = 0.14;
    const TRAIL_READING_LINE = 0.58;
    // Eighteen bisection steps locate the trail position to well under a pixel.
    const TRAIL_SEARCH_ITERATIONS = 18;
    const page = document.querySelector<HTMLElement>('.team-page');
    const trail = page?.querySelector<SVGSVGElement>('.scroll-trail');
    const trailBase = trail?.querySelector<SVGPathElement>('.trail-base');
    const trailProgress = trail?.querySelector<SVGPathElement>('.trail-progress');
    const trailDot = trail?.querySelector<SVGCircleElement>('.trail-dot');
    const matrix = page?.querySelector<HTMLElement>('.hero-matrix');
    const matrixCells = Array.from(matrix?.querySelectorAll<HTMLElement>('.matrix-cell') ?? []);
    const layers = Array.from(page?.querySelectorAll<HTMLElement>('[data-depth]') ?? []);
    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
    const layerDocumentCentres = new Map<HTMLElement, number>();
    const refreshLayerCentres = () => {
        layers.forEach((layer) => {
            const rect = layer.getBoundingClientRect();
            const currentOffset = parseFloat(layer.style.getPropertyValue('--parallax-y')) || 0;
            layerDocumentCentres.set(layer, rect.top + scrollY - currentOffset + rect.height / 2);
        });
    };
    const scrollUpdates = new Set<() => void>();
    let scrollFrame = 0;
    const scheduleScrollUpdates = () => {
        if (scrollFrame) return;
        scrollFrame = requestAnimationFrame(() => {
            scrollFrame = 0;
            scrollUpdates.forEach((update) => update());
        });
    };
    const updateParallax = () => {
        if (reducedMotion.matches) {
            layers.forEach((layer) => layer.style.removeProperty('--parallax-y'));
            return;
        }
        layers.forEach((layer) => {
            const speed = Number(layer.dataset.depth) || 0;
            const centre = layerDocumentCentres.get(layer) ?? scrollY;
            const offset = (innerHeight / 2 - centre + scrollY) * speed;
            layer.style.setProperty('--parallax-y', `${offset}px`);
        });
    };
    scrollUpdates.add(updateParallax);
    reducedMotion.addEventListener('change', updateParallax);
    const refreshAndUpdatePositions = () => {
        refreshLayerCentres();
        scheduleScrollUpdates();
    };
    refreshAndUpdatePositions();
    updateParallax();
    addEventListener('load', refreshAndUpdatePositions);
    document.fonts.ready.then(refreshAndUpdatePositions);

    if (matrix && matrixCells.length) {
        const resetMatrix = () => {
            matrixCells.forEach((cell) => {
                cell.style.opacity = cell.dataset.opacity ?? '';
                cell.style.removeProperty('--cell-turn');
                cell.style.removeProperty('--cell-scale');
                cell.style.transitionDelay = '';
            });
        };

        matrix.addEventListener('pointermove', (event) => {
            if (reducedMotion.matches) return;
            const bounds = matrix.getBoundingClientRect();
            const pointerX = ((event.clientX - bounds.left) / bounds.width) * MATRIX_COLUMNS;
            const pointerY = ((event.clientY - bounds.top) / bounds.height) * MATRIX_ROWS;
            const radius = 4.25;

            matrixCells.forEach((cell) => {
                const x = Number(cell.dataset.x);
                const y = Number(cell.dataset.y);
                const distance = Math.hypot(x + 0.5 - pointerX, y + 0.5 - pointerY);
                const intensity = Math.max(0, 1 - distance / radius);
                const baseOpacity = Number(cell.dataset.opacity) || 0;
                cell.style.opacity = String(Math.min(1, baseOpacity + intensity * 0.72));
                cell.style.setProperty('--cell-turn', `${intensity > 0.12 && (x + y) % 2 ? 180 : 0}deg`);
                cell.style.setProperty('--cell-scale', String(1 + intensity * 0.12));
                cell.style.transitionDelay = `${Math.max(0, distance - 0.5) * 14}ms`;
            });
        });

        matrix.addEventListener('pointerleave', resetMatrix);
        reducedMotion.addEventListener('change', () => {
            if (reducedMotion.matches) resetMatrix();
        });
    }

    if (page && trail && trailBase && trailProgress && trailDot) {
        let pathLength = 0;
        let firstY = 0;
        let lastY = 0;
        let drawFrame = 0;

        const drawTrail = () => {
            const bounds = page.getBoundingClientRect();
            const width = page.clientWidth;
            const height = page.scrollHeight;
            trail.setAttribute('viewBox', `0 0 ${width} ${height}`);
            trail.setAttribute('width', String(width));
            trail.setAttribute('height', String(height));

            const anchors = Array.from(page.querySelectorAll<HTMLElement>('[data-trail-section]'));
            const points = anchors.map((anchor, index) => {
                const heading = anchor.querySelector<HTMLElement>('h1, h2, h3') ?? anchor;
                const rect = heading.getBoundingClientRect();
                return {
                    x: width * (index === 0 ? TRAIL_CENTER_X : index % 2 ? TRAIL_RIGHT_X : TRAIL_LEFT_X),
                    y: anchor.hasAttribute('data-trail-end') ? height - 8 : rect.top - bounds.top + rect.height / 2,
                };
            });
            firstY = points[0]?.y ?? 0;
            lastY = points.at(-1)?.y ?? firstY;

            const path = points.reduce((data, point, index) => {
                if (index === 0) return `M ${point.x} ${point.y}`;
                const previous = points[index - 1];
                const middleY = (previous.y + point.y) / 2;
                return `${data} C ${previous.x} ${middleY}, ${point.x} ${middleY}, ${point.x} ${point.y}`;
            }, '');

            trailBase.setAttribute('d', path);
            trailProgress.setAttribute('d', path);
            pathLength = trailProgress.getTotalLength();
            trailProgress.style.strokeDasharray = `${pathLength} ${pathLength}`;
            update();
        };

        const update = () => {
            const bounds = page.getBoundingClientRect();
            if (reducedMotion.matches) {
                trailProgress.style.strokeDashoffset = '0';
                trailDot.setAttribute('visibility', 'hidden');
                return;
            }

            trailDot.removeAttribute('visibility');
            const targetY = Math.min(Math.max(innerHeight * TRAIL_READING_LINE - bounds.top, firstY), lastY);
            let low = 0;
            let high = pathLength;
            for (let i = 0; i < TRAIL_SEARCH_ITERATIONS; i += 1) {
                const middle = (low + high) / 2;
                if (trailProgress.getPointAtLength(middle).y < targetY) low = middle;
                else high = middle;
            }
            const length = (low + high) / 2;
            trailProgress.style.strokeDashoffset = String(pathLength - length);
            const point = trailProgress.getPointAtLength(length);
            trailDot.setAttribute('cx', String(point.x));
            trailDot.setAttribute('cy', String(point.y));
        };

        const scheduleDraw = () => {
            if (drawFrame) return;
            drawFrame = requestAnimationFrame(() => {
                drawFrame = 0;
                drawTrail();
            });
        };

        scrollUpdates.add(update);
        drawTrail();
        addEventListener('resize', scheduleDraw);
        addEventListener('load', scheduleDraw);
        document.fonts.ready.then(scheduleDraw);
        const resizeObserver = new ResizeObserver(scheduleDraw);
        resizeObserver.observe(page);
        reducedMotion.addEventListener('change', scheduleDraw);
    }

    addEventListener('resize', refreshAndUpdatePositions);
    addEventListener('scroll', scheduleScrollUpdates, { passive: true });
    addEventListener('v2-lenis-scroll', scheduleScrollUpdates);
</script>

<style>
    .team-page {
        --team-ink: #34394b;
        --team-cream: #fffcf3;
        --team-blue: #3a718b;
        --team-purple: #776b87;
        --team-accent-pink: #d94a65;
        --team-accent-purple: #8c7898;
        --team-accent-blue: #119bd6;
        --team-accent-gold: #f4b000;
        position: relative;
        isolation: isolate;
        container-type: inline-size;
        overflow: clip;
        min-height: 100vh;
        padding: 0;
        background:
            radial-gradient(circle, rgb(52 57 75 / 0.18) 1px, transparent 1.5px) 0 0 / 18px 18px,
            radial-gradient(circle, rgb(255 252 243 / 0.48) 1px, transparent 1.7px) 88% 12rem / 11px 11px,
            linear-gradient(90deg, rgb(217 74 101 / 0.18), transparent 18%, transparent 78%, rgb(58 113 139 / 0.22)),
            linear-gradient(135deg, #e7c5c1 0%, #e0d5e7 33%, #c8dce3 62%, #e9d3bd 100%);
        color: var(--team-ink);
        font-family: var(--font-syne), sans-serif;
    }

    .team-page::before,
    .team-page::after {
        position: absolute;
        inset: 0;
        z-index: -1;
        pointer-events: none;
        content: '';
    }

    .team-page::before {
        background:
            repeating-linear-gradient(135deg, transparent 0 18px, rgb(52 57 75 / 0.12) 19px 20px, transparent 21px 38px) left top / 7vw 100%,
            repeating-linear-gradient(45deg, transparent 0 18px, rgb(52 57 75 / 0.12) 19px 20px, transparent 21px 38px) right top / 7vw 100%,
            radial-gradient(circle, rgb(52 57 75 / 0.2) 1px, transparent 1.5px) left top / 7vw 14px,
            radial-gradient(circle, rgb(52 57 75 / 0.2) 1px, transparent 1.5px) right top / 7vw 14px;
        background-repeat: repeat-y;
    }

    .team-page::after {
        background:
            radial-gradient(circle at center, transparent 42%, rgb(119 107 135 / 0.3) 43% 44%, transparent 45%) 1vw 12rem / 5rem 5rem no-repeat,
            radial-gradient(circle at center, transparent 42%, rgb(58 113 139 / 0.34) 43% 44%, transparent 45%) calc(100% - 1vw) 42rem / 6rem 6rem no-repeat,
            conic-gradient(from 45deg, var(--team-accent-pink) 0 25%, var(--team-accent-purple) 0 50%, var(--team-accent-blue) 0 75%, var(--team-accent-gold) 0) 1.8vw 33rem / 0.7rem 0.7rem no-repeat,
            conic-gradient(from 45deg, var(--team-accent-pink) 0 25%, var(--team-accent-purple) 0 50%, var(--team-accent-blue) 0 75%, var(--team-accent-gold) 0) calc(100% - 2vw) 67rem / 0.9rem 0.9rem no-repeat;
        opacity: 0.65;
    }

    .ambient-background {
        position: absolute;
        inset: 0;
        z-index: -1;
        overflow: hidden;
        pointer-events: none;
    }

    .ambient-cloud {
        position: absolute;
        width: clamp(12rem, 25vw, 27rem);
        aspect-ratio: 1;
        border-radius: 50%;
        filter: blur(8px);
        transform: translate3d(0, var(--parallax-y, 0), 0);
    }

    .cloud-one {
        top: 8%;
        left: -12%;
        background: radial-gradient(circle, rgb(140 120 152 / 0.34), rgb(217 74 101 / 0.18) 52%, transparent 72%);
    }

    .cloud-two {
        top: 45%;
        right: -12%;
        background: radial-gradient(circle, rgb(58 113 139 / 0.34), rgb(217 188 176 / 0.3) 52%, transparent 72%);
    }

    .ambient-sun {
        position: absolute;
        top: 75%;
        left: 0;
        width: 22rem;
        aspect-ratio: 1;
        border-radius: 50%;
        background: radial-gradient(circle, rgb(217 74 101 / 0.2), rgb(244 176 0 / 0.16), transparent 70%);
        transform: translate3d(0, var(--parallax-y, 0), 0);
    }

    .side-geometry {
        position: absolute;
        width: clamp(3rem, 6vw, 6rem);
        aspect-ratio: 1;
        border: 1px solid rgb(52 57 75 / 0.28);
        transform: translate3d(0, var(--parallax-y, 0), 0) rotate(45deg);
    }

    .geometry-left-one {
        top: 19%;
        left: 1.5%;
        border-radius: 50%;
        box-shadow: inset 0 0 0 0.5rem rgb(255 252 243 / 0.12), 0 0 0 0.5rem rgb(217 74 101 / 0.12);
    }

    .geometry-right-one {
        top: 35%;
        right: 1.2%;
        width: clamp(2rem, 4vw, 4rem);
        background: repeating-linear-gradient(0deg, transparent 0 5px, rgb(52 57 75 / 0.2) 6px 7px);
    }

    .geometry-left-two {
        top: 64%;
        left: 2%;
        width: clamp(2rem, 3.8vw, 4rem);
        border-color: rgb(58 113 139 / 0.5);
        transform: translate3d(0, var(--parallax-y, 0), 0) rotate(45deg) scale(0.82);
    }

    .geometry-right-two {
        top: 82%;
        right: 1.6%;
        border-radius: 50%;
        border-style: dashed;
        box-shadow: inset 0 0 0 0.6rem rgb(140 120 152 / 0.12);
    }

    .team-panel {
        position: relative;
        width: auto;
        margin: 0 clamp(10px, 2.4vw, 38px) 0 calc(4.13vw + clamp(10px, 1.4vw, 22px));
        overflow: clip;
        border-right: 1px solid rgb(72 75 112 / 0.12);
        border-left: 1px solid rgb(72 75 112 / 0.12);
        background: transparent;
        box-shadow: 0 0 3rem rgb(52 57 75 / 0.08);
    }

    .rail-tail-space {
        height: clamp(2.5rem, 5vw, 4rem);
        background: #fffcf3;
    }

    .team-body {
        position: relative;
    }

    .team-content {
        position: relative;
        z-index: 2;
    }

    .scroll-trail {
        position: absolute;
        inset: 0 auto auto 0;
        z-index: 1;
        overflow: visible;
        pointer-events: none;
    }

    .trail-base,
    .trail-progress {
        fill: none;
        stroke: url(#trail-gradient);
        stroke-linecap: round;
    }

    .trail-base {
        stroke-width: 4;
        stroke-dasharray: 3 10;
        opacity: 0.5;
    }

    .trail-progress {
        stroke-width: 5;
        filter: drop-shadow(0 0 6px rgb(119 107 135 / 0.52));
    }

    .trail-dot {
        fill: #fffcf3;
        stroke: var(--team-accent-purple);
        stroke-width: 4;
        filter: drop-shadow(0 0 5px rgb(119 107 135 / 0.4));
    }

    .team-hero {
        position: relative;
        isolation: isolate;
        overflow: hidden;
        min-height: clamp(16rem, 25vw, 23rem);
        padding: clamp(1.5rem, 3.3vw, 3rem) clamp(1.5rem, 4vw, 4.5rem);
        background:
            radial-gradient(ellipse at 8% 6%, rgb(217 74 101 / 0.14), transparent 39%),
            radial-gradient(ellipse at 86% 92%, rgb(119 107 135 / 0.18), transparent 42%),
            radial-gradient(ellipse at 65% 12%, rgb(58 113 139 / 0.16), transparent 35%),
            linear-gradient(110deg, #f2e9e3, #fffcf3 54%, #e9edf0);
    }

    .team-hero::before {
        position: absolute;
        inset: 0;
        z-index: -1;
        background:
            radial-gradient(circle, rgb(52 57 75 / 0.13) 1px, transparent 1.6px) 50% 50% / 17px 17px,
            linear-gradient(135deg, transparent 0 48%, rgb(52 57 75 / 0.1) 48.2% 48.4%, transparent 48.6% 100%);
        mask-image: linear-gradient(90deg, #000, transparent 34%, transparent 75%, #000);
        content: '';
    }


---
import Container from '../../components/Container.astro';
import Header from '../../components/Header.astro';
import Layout from '../../layouts/Layout.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { sections } from '../../data/team';

// Build-time optimised board photos. Source files live in src/assets so Astro
// can resize/compress them at build (originals are 5184px-wide, multi-MB DSLR
// JPGs); files in public/ are served untouched, which is what made this page slow.
const photos = import.meta.glob<{ default: ImageMetadata }>(
    '../../assets/meet-the-team/datasoc-board-photos/*.jpg',
    { eager: true },
);

function photo(file?: string): ImageMetadata | undefined {
    if (!file) return undefined;
    const entry = photos[`../../assets/meet-the-team/datasoc-board-photos/${file}`];
    if (!entry) throw new Error(`Board photo not found: ${file}`);
    return entry.default;
}

// Board photos render at ~150-300px on screen. Generate a small srcset and let
// the browser pick the smallest candidate that covers the card at its current
// viewport width (per-section `sizes` below), instead of shipping one 700px
// image to every device. 700 is the retina (2x) ceiling for the largest card.
const IMAGE_WIDTHS = [240, 380, 540, 700];

---

<Layout title="Meet the team - UNSW Data Science Society">
    <Header>
        <h1>Meet the team</h1>
        <p>Meet the people behind UNSW DataSoc.</p>
    </Header>

    <Container class="space-y-16 py-6 max-w-6xl">
        {sections.map((section) => (
            <section class="space-y-6">
                <h2 class="text-2xl font-bold text-center">{section.title}</h2>

                <div class="flex flex-wrap justify-center gap-8">
                    {section.members.map((member) => {
                        const image = photo(member.file);
                        return (
                            <div class:list={['text-center', section.cardClass]}>
                                {image ? (
                                    <Image
                                        src={image}
                                        alt={member.name}
                                        widths={IMAGE_WIDTHS}
                                        sizes={section.sizes}
                                        loading={section.eager ? 'eager' : 'lazy'}
                                        class="w-full h-80 object-cover rounded-lg"
                                    />
                                ) : (
                                    <div
                                        role="img"
                                        aria-label={`${member.name} photo unavailable`}
                                        class="w-full h-80 rounded-lg border border-gray-200 bg-gray-50 flex items-center justify-center"
                                    >
                                        <span class="text-sm text-gray-400" aria-hidden="true">Photo unavailable</span>
                                    </div>
                                )}
                                <p class="mt-3 font-semibold">{member.name}</p>
                                <p class="text-sm text-gray-600">{member.role}</p>
                            </div>
                        );
                    })}
                </div>
            </section>
        ))}
    </Container>
</Layout>

---
const { text, classes, linkto = "", useMobile } = Astro.props;

const navbarClasses =
  "text-sm font-semibold text-gray-900 transition-colors transition-transform duration-200 hover:text-purple-600 hover:scale-110";

const mobileNavbarClasses = "block";
---

<a
  href={`/${linkto}`}
  class={`${classes} ${useMobile == "True" ? mobileNavbarClasses : navbarClasses}`}
>
  {text}
</a>

---
// Feature flag: Set to true to enable merch features
const MERCH_ENABLED = false;
import NavbarRefs from "./NavbarRefs.astro";
import { navbar } from "./constants.js";
---

<!-- Desktop Navbar (hidden on mobile) -->
<nav
  class="hidden lg:flex items-center justify-between px-6 py-4 lg:px-8 bg-[#fffb] backdrop-blur-md fixed top-0 inset-x-0 z-40"
  aria-label="Global"
>
  <!-- Logo -->
  <div class="flex lg:flex-1">
    <a href="/" class="-m-1.5 p-1.5 hover:scale-110">
      <span class="sr-only">DataSoc</span>
      <img class="h-8 w-auto" src="/logo.png" alt="logo" />
    </a>
  </div>

  <!-- Navigation Links -->
  <div class="lg:flex lg:gap-x-12">
    {
      navbar.map(({ text, linkto }) => (
        <NavbarRefs text={text} linkto={linkto} useMobile="False" />
      ))
    }
  </div>

  <!-- Right-aligned items -->
  <div class="lg:flex lg:flex-1 lg:justify-end lg:items-center lg:gap-x-4">
    {
      MERCH_ENABLED && (
        <a href="/merch" class="merch-button">
          MERCH
        </a>
      )
    }
    <a
      href="/contact"
      class="text-sm font-semibold text-gray-900 transition-colors transition-transform duration-200 hover:text-purple-600 hover:scale-110"
    >
      Contact Us
    </a>
  </div>
</nav>

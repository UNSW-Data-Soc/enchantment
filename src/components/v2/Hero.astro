---
import { Image } from 'astro:assets';
import heroLogo from '../../../public/icons/datasoc/unsw-datasoc-logo-v2.png';
import ParallaxContainer from './ParallaxContainer.astro';

interface Props {
	joinHref?: string;
	aboutHref?: string;
}

const {
	joinHref = 'https://forms.gle/3s3r3BAKBuur8LeS9',
	aboutHref = '/meet-the-team/',
} = Astro.props;
---

<section class="hero" aria-label="UNSW Data Science Society">
	<ParallaxContainer speed={0.06}>
		<div class="hero-content">
			<h1 class="hero-logo">
				<Image
					src={heroLogo}
					alt="UNSW Data Science Society"
					width={1127}
					sizes="(max-width: 600px) 70vw, 50vw"
					class="logo-image"
					loading="eager"
					fetchpriority="high"
				/>
			</h1>

			<p class="hero-description">
				Uniting students with a passion for data science,
				machine learning, and artificial intelligence.
			</p>

			<div class="hero-buttons">
				<a href={aboutHref} class="hero-button team-button">Meet the Team</a>
				<a href={joinHref} class="hero-button join-button">Join Us</a>
			</div>
		</div>
	</ParallaxContainer>
</section>

<style>
	.hero {
		box-sizing: border-box;
		height: 100%;
		padding: 15vw 0 0 3.3vw;
		font-family: var(--font-syne), sans-serif;
		color: #fffcf3;
	}

	.hero :global(.parallax-container) {
		width: 100%;
	}

	.hero-content {
		width: 50vw;
	}

	.hero-logo {
		margin: 0;
		width: 50vw;
		/* The logo has transparent space below its lettering. */
		height: 28vw;
		overflow: clip;
	}

	.logo-image {
		display: block;
		width: 100%;
		height: auto;
	}

	.hero-description {
		width: 33.5vw;
		margin: 0 0 0 5.7vw;
		font-size: clamp(0.75rem, 1.3vw, 1.5rem);
		line-height: 1.15;
		text-align: justify;
		text-shadow: 0 1px 6px rgb(36 59 83 / 0.35);
	}

	.hero-buttons {
		display: flex;
		gap: 1.7vw;
		margin: 2.2vw 0 0 6.7vw;
	}

	.hero-button {
		box-sizing: border-box;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 14.5vw;
		min-height: max(44px, 3.1vw);
		padding: 0.65vw 1vw;
		border: 2px solid #fffcf3;
		border-radius: 1vw;
		background: linear-gradient(
			110deg,
			rgb(124 144 211 / 0.65),
			rgb(152 102 186 / 0.7),
			rgb(233 124 147 / 0.65)
		);
		color: #fffcf3;
		font-size: clamp(0.75rem, 1.15vw, 1.375rem);
		font-weight: 700;
		line-height: 1.3;
		white-space: nowrap;
		text-decoration: none;
		box-shadow: 0 0.25vw 0.8vw rgb(36 59 83 / 0.2);
	}

	.hero-button:focus-visible {
		outline: 3px solid #243b53;
		outline-offset: 4px;
	}

	@media (prefers-reduced-motion: no-preference) {
		.hero-content {
			animation: hero-enter 0.7s ease-out both;
		}

		.hero-button {
			transition: transform 0.2s, box-shadow 0.2s;
		}

		.hero-button:hover {
			transform: translateY(-3px);
			box-shadow: 0 0.45vw 1vw rgb(36 59 83 / 0.3);
		}

		.hero-button:active {
			transform: translateY(1px);
		}
	}

	@keyframes hero-enter {
		from {
			opacity: 0;
			transform: translateY(20px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@media (max-width: 600px) {
		.hero {
			padding: 8vw 0 0;
		}

		.hero-content {
			width: 88vw;
		}

		.hero-logo {
			width: 70vw;
			height: 40vw;
		}

		.hero-description {
			width: 82vw;
			font-size: 0.75rem;
			line-height: 1.35;
			text-align: left;
		}

		.hero-buttons {
			width: 82vw;
			gap: 0.5rem;
			margin-top: 0.75rem;
		}

		.hero-button {
			flex: 1;
			width: auto;
			min-height: 44px;
			padding: 0.5rem;
			border-radius: 0.5rem;
			font-size: 0.75rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hero :global(.parallax-container) {
			transform: none;
			will-change: auto;
		}
	}

	.hero-logo {
		overflow: visible;
	}

	.logo-image {
		filter: drop-shadow(0 6px 5px rgb(36 45 60 / 0.35));
	}

	/* Give letters such as g and y more vertical space. */
	.hero-description {
		font-family: Arial, sans-serif;
		line-height: 1.4;
		padding-bottom: 0.2em;
		overflow: visible;
		text-shadow: 0 2px 3px rgb(36 45 60 / 0.35);
		text-indent: 2.4vw;
	}
	.hero-button {
		background: rgb(99 100 118 / 0.32);
		box-shadow: 0 5px 10px rgb(36 45 60 / 0.3);
	}

	.hero-button.join-button {
		background: linear-gradient(
			105deg,
			#9d7ec7 0%,
			#7971be 42%,
			#848bcb 66%,
			#b97bb1 100%
		);
	}

	@media (prefers-reduced-motion: no-preference) {
		.hero-button:hover {
			transform: translateY(-3px);
			box-shadow: 0 9px 16px rgb(36 45 60 / 0.35);
		}
	}
</style>
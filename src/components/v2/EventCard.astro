---
import type { FacebookEvent } from '../../api/api.ts';

interface Props {
  event: FacebookEvent;
}

const { event } = Astro.props;
---

<a class="event-card" href={`https://www.facebook.com/events/${event.id}`} target="_blank" rel="noopener noreferrer">
  <div class="event-image">
    {event.cover?.source ? (
      <img src={event.cover.source} alt="" loading="lazy" decoding="async" />
    ) : (
      <span class="image-placeholder">Event image unavailable</span>
    )}
  </div>
  <h3>{event.name}</h3>
  <span class="visually-hidden"> (opens in a new tab)</span>
</a>

<style>
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>

---
import type { FacebookEvent } from '../../api/api.ts';
import { getV2Messages } from '../../i18n/v2';
const messages = getV2Messages(Astro.currentLocale);

interface Props {
  event: FacebookEvent;
}

const { event } = Astro.props;
---

<a class="event-card" href={`https://www.facebook.com/events/${event.id}`} target="_blank" rel="noopener noreferrer">
  <div class="event-image">
    {event.cover?.source ? (
      <img src={event.cover.source} alt="" loading="lazy" decoding="async" />
    ) : (
      <span class="image-placeholder">{messages['events.imageUnavailable']}</span>
    )}
  </div>
  <h3>{event.name}</h3>
  <span class="sr-only">{messages['common.opensNewTab']}</span>
</a>

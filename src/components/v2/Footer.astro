---
import { quicklinks } from "./constants.js";
---

<footer class="v2-footer">
	<img class="footer-art" src="/backgrounds/footer-bg.png" alt="" />
	<img class="quicklinks-header" src="/text-headers/quicklinks-header.png" alt="Quick links" />

	<div class="quick-links">
		{quicklinks.map((item) => (
			<a href={`/${item.linkto}`}>{item.text}</a>
		))}
	</div>
</footer>

<style>
	.v2-footer {
		position: relative;
		width: 100%;
		aspect-ratio: 40 / 18;
		background-color: #fffcf3;
		overflow: hidden;
	}

	.footer-art {
		position: absolute;
		bottom: 0;
		left: 0;
		display: block;
		width: 100%;
		height: auto;
		z-index: 1;
	}

	.quicklinks-header {
		position: absolute;
		top: 26.5%;
		left: 66%;
		width: clamp(72px, 15vw, 210px);
		height: auto;
		transform: translateX(-50%);
		z-index: 2;
	}

	@font-face {
		font-family: "Inter";
		src: url("/Inter-VariableFont_opsz,wght.ttf") format("truetype");
		font-weight: 100 900;
		font-style: normal;
	}

	.quick-links {
		position: absolute;
		top: 49%;
		left: 56%;
		display: flex;
		flex-direction: column;
		gap: 18px;
		z-index: 2;
	}

	.quick-links a {
		color: white;
		text-decoration: underline;
		font-family: "Inter", sans-serif;
		font-size: 14px;
	}
</style>

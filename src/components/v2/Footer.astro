8Q193.2 309.9 192 309.7L193.8 309.7Q195.1 309.9 196.3 310.5Q197.4 311.2 198.4 312.3Q199.4 313.4 200 314.9Q200.5 316.4 200.5 318.3ZM206.9 331.2L206.5 335.8L181.5 333.5L182 328.9ZM197.9 350.1L189.6 338.7L192.4 339.1L180.1 349.3L180.6 343.4L191.5 334.6L198.5 343.8ZM185.8 350.6L185.1 354.8Q183.8 355 182.8 356.1Q181.9 357.2 181.5 359.2Q181.3 360.5 181.4 361.3Q181.6 362.1 182 362.5Q182.4 362.8 183 362.9Q183.8 363.1 184.2 362.7Q184.7 362.3 185.1 361.4Q185.6 360.4 186 359Q186.5 357.6 187.1 356.2Q187.7 354.9 188.4 353.9Q189.2 353 190.2 352.5Q191.2 352 192.5 352.3Q193.8 352.5 194.7 353.3Q195.6 354.1 196.1 355.3Q196.6 356.5 196.7 358.1Q196.8 359.6 196.5 361.4Q196 364 195 365.6Q193.9 367.2 192.4 367.8Q190.9 368.5 189.1 368.2L189.8 364.1Q191.2 364.1 191.9 363.3Q192.6 362.6 192.9 360.8Q193.2 359 192.8 358.1Q192.4 357.1 191.5 356.9Q190.8 356.8 190.3 357.3Q189.8 357.8 189.4 358.8Q188.9 359.9 188.4 361.4Q187.8 362.8 187.3 364Q186.7 365.2 186 366.1Q185.3 367 184.3 367.4Q183.3 367.8 181.9 367.6Q180.2 367.3 179.2 366.1Q178.2 365 177.9 363.1Q177.6 361.1 178 358.6Q178.4 356.4 179.1 354.9Q179.9 353.3 180.8 352.4Q181.7 351.5 182.7 351Q183.7 350.6 184.5 350.5Q185.3 350.4 185.8 350.6Z" />
      </svg>

      <!-- The header is decorative: the nav's label carries its words, so they're read once. -->
      <nav class="quick-links" aria-label="Quick links">
        {quicklinks.map((item) => <a href={`/${item.linkto}`}>{item.text}</a>)}
      </nav>
    </div>
  </div>
  <div class="scroll-btn-wrapper">
    <button type="button" class="scroll-btn" aria-label="Scroll to top" disabled>
      <img src={buttonImage.src} alt="" />
    </button>
  </div>
</footer>

<script>
  document.querySelectorAll<HTMLButtonElement>(".v2-footer .scroll-btn").forEach((button) => {
    const footer = button.closest<HTMLElement>(".v2-footer")!;
    const wrapper = button.parentElement!;
    const observer = new IntersectionObserver(([entry]) => {
      wrapper.classList.toggle("is-visible", entry.isIntersecting);
      button.disabled = !entry.isIntersecting;
    }, { threshold: 0 });
    observer.observe(footer);

    button.addEventListener("click", () => {
      const immediate = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const request = new CustomEvent("v2-lenis-scroll-to", {
        cancelable: true,
        detail: { top: 0, immediate },
      });

      if (window.dispatchEvent(request)) {
        window.scrollTo({ top: 0, behavior: immediate ? "instant" : "smooth" });
      }
    });
  });
</script>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@100..900&display=swap');
  .v2-footer {
    /* The links stop shrinking at 12px, and below this width they no longer fit inside the artwork's arc, so
       narrower screens see a crop of the footer at this width instead of a scaled-down one. */
    --min-art-width: 56rem;
    position: relative;
    width: 100%;
    aspect-ratio: 40 / 16;
    min-height: calc(var(--min-art-width) * 16 / 40);
    background-color: #fffcf3;
    container-type: inline-size;
  }

  .footer-viewport {
    /* Crop the responsive artwork without clipping the scroll button above the footer. */
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .footer-content {
    position: absolute;
    bottom: 0;
    /* Crops more from the left than the right, keeping the quick links in view. */
    left: calc((100% - max(100%, var(--min-art-width))) * 0.6);
    width: max(100%, var(--min-art-width));
    height: 100%;
    container-type: inline-size;
  }

  .footer-art {
    position: absolute;
    bottom: 0;
    left: 0;
    display: block;
    width: 100%;
    aspect-ratio: 1708 / 581;
    background-image: url("/backgrounds/footer-bg.png");
    background-size: 100% auto;
    background-repeat: no-repeat;
    pointer-events: none;
    z-index: 1;
  }

  .quicklinks-header {
    position: absolute;
    /* Positioned so the text's arc is concentric with the art's grey ring, 66px in (derivation in #98); re-derive
       if the art or the lettering changes. */
    top: 19.43%;
    left: 59.63%;
    width: 13.21%;
    height: auto;
    overflow: visible;
    z-index: 2;
  }

  .scroll-btn-wrapper {
    position: absolute;
    top: 10%;
    right: 4%;
    padding-bottom: 8px;
    transform: translateY(-100%);
    clip-path: inset(-30px -30px 0 -30px);
    pointer-events: none;
    z-index: 0;
  }

  .scroll-btn {
    padding: 0;
    border: 0;
    background: transparent;
    width: clamp(48px, 5.5cqw, 80px);
    aspect-ratio: 76 / 74;
    cursor: pointer;
    filter: drop-shadow(6px 6px 10px rgba(0, 0, 0, 0.3));
    display: flex;
    justify-content: center;
    align-items: center;
    transform: translateY(calc(100% + 16px));
    transition: transform 0.4s ease-out;
  }

  .scroll-btn-wrapper.is-visible {
    pointer-events: auto;
  }

  .scroll-btn-wrapper.is-visible .scroll-btn {
    transform: translateY(0);
  }

  .scroll-btn img {
    display: block;
    width: 75%;
    height: auto;
  }

  .scroll-btn-wrapper.is-visible .scroll-btn:hover {
    transform: scale(1.05);
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll-btn {
      transition: none;
    }
  }
  .quick-links {
    position: absolute;
    top: 38.125%;
    left: 53.5%;
    display: flex;
    flex-direction: column;
    /* The links scale with the artwork so they stay inside its arc. */
    gap: 1.6cqw;
    z-index: 2;
  }

  .quick-links a {
    color: white;
    text-decoration: underline;
    font-family: 'Inter', sans-serif;
    font-size: clamp(12px, 1.04cqw, 15px);
    cursor: pointer;
  }

  /* The links sit on the artwork's dark band, where the default navy ring would vanish. */
  .quick-links a:focus-visible {
    outline: 2px solid #fffcf3;
    outline-offset: 3px;
  }
</style>

---
import { quicklinks } from './constants.js';
---

<footer class="v2-footer">
<div class="footer-content">
  <div class="footer-art" aria-hidden="true"></div>

  <img
    class="quicklinks-header"
    src="/text-headers/quicklinks-header.png"
    alt="Quick links"
    draggable="false"
  />

  <div class="quick-links">
    {quicklinks.map((item) => (
      <a href={`/${item.linkto}`}>{item.text}</a>
    ))}
  </div>
</div>
</footer>

<style>
	@import url('https://fonts.googleapis.com/css2?family=Inter:wght@100..900&display=swap');
	.v2-footer {
		/* The links stop shrinking at 12px, and below this width they no longer fit inside the artwork's arc, so
		   narrower screens see a crop of the footer at this width instead of a scaled-down one. */
		--min-art-width: 56rem;
		position: relative;
		width: 100%;
		aspect-ratio: 40 / 16;
		min-height: calc(var(--min-art-width) * 16 / 40);
		background-color: #fffcf3;
		overflow: hidden;
	}

	.footer-content {
		position: absolute;
		bottom: 0;
		/* Crops more from the left than the right, keeping the quick links in view. */
		left: calc((100% - max(100%, var(--min-art-width))) * 0.6);
		width: max(100%, var(--min-art-width));
		height: 100%;
		container-type: inline-size;
	}

	.footer-art {
		position: absolute;
		bottom: 0;
		left: 0;
		display: block;
		width: 100%;
		aspect-ratio: 1708 / 581;
		background-image: url('/backgrounds/footer-bg.png');
		background-size: 100% auto;
		background-repeat: no-repeat;
		pointer-events: none;
		z-index: 1;
	}

	.quicklinks-header {
		position: absolute;
		/* Positioned so the text's arc is concentric with the art's grey ring, 66px in (derivation in #98); re-derive
		   if either image changes. */
		top: 19.43%;
		left: 59.63%;
		width: 13.21%;
		height: auto;
		z-index: 2;
	}

	.quick-links {
		position: absolute;
		top: 38.125%;
		left: 53.5%;
		display: flex;
		flex-direction: column;
		/* The links scale with the artwork so they stay inside its arc. */
		gap: 1.6cqw;
		z-index: 2;
	}

  .quick-links a {
    color: white;
    text-decoration: underline;
    font-family: 'Inter', sans-serif;
    font-size: clamp(12px, 1.04cqw, 15px);
    cursor: pointer;
  }
</style>

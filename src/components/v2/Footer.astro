---
import Parallax from "./ParallaxContainer.astro";
---

<footer class="v2-footer">
	<img class="footer-art" src="/backgrounds/footer-bg.png" alt="" />
	<img class="quicklinks-header" src="/text-headers/quicklinks-header.png" alt="Quick links" />

	<Parallax>
	<div class="scroll-btn-wrapper">
		<div
			class="scroll-btn"
			onclick="window.scrollTo({ top: 0, behavior: 'smooth' })"
		>
			<img src="/scroll-to-top-arrow.png" alt="Scroll to top" />
		</div>
	</div>
</Parallax>
</footer>

<style>
	.v2-footer {
		position: relative;
		width: 100%;
		aspect-ratio: 40 / 18;
		background-color: #fffcf3;
		overflow: hidden;
	}

	.footer-art {
		position: absolute;
		bottom: 0;
		left: 0;
		display: block;
		width: 100%;
		height: auto;
		z-index: 1;
	}

	.quicklinks-header {
		position: absolute;
		top: 26.5%;
		left: 66%;
		width: clamp(72px, 15vw, 210px);
		height: auto;
		transform: translateX(-50%);
		z-index: 2;
	}

	.scroll-btn-wrapper {
	position: relative;
	height: 200px;
}

.scroll-btn {
	width: 80px;
	height: 80px;
	position: sticky;
	top: 80px;
	margin-left: 90%;
	background-color: rgb(212, 119, 119);
	border-radius: 12px;
	cursor: pointer;
	display: flex;
	justify-content: center;
	align-items: center;
	box-shadow: 10px 10px 20px 5px rgba(0, 0, 0, 0.3);
	display: flex;
	justify-content: center;
	align-items: center;
}

.scroll-btn img {
	width: 50px;
	height: 50px;
	filter: brightness(0) invert(1);
}

.scroll-btn:hover {
	transform: translateY(-5px);
}
</style>


---
import { quicklinks } from "./constants.js";
---

<footer class="v2-footer">
  <div class="footer-content">
    <div class="footer-art" aria-hidden="true"></div>

    <nav class="quicklinks-container" aria-label="Footer quick links">
      <img
        class="quicklinks-header"
        src="/text-headers/quicklinks-header.png"
        alt="DataSoc Quicklinks"
        draggable="false"
      />

      <div class="quick-links">
        {quicklinks.map((item) => (
          <a href={`/${item.linkto}`}>{item.text}</a>
        ))}
      </div>
    </nav>
  </div>
</footer>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@100..900&display=swap');

  .v2-footer {
    position: relative;
    width: 100%;
    aspect-ratio: 1708 / 581;
    background-color: #fffcf3;
    overflow: hidden;
    container-type: inline-size;
  }

  .footer-content {
    position: absolute;
    inset: 0;
  }

  .footer-art {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    background-image: url('/backgrounds/footer-bg.png');
    background-size: 100% 100%;
    background-repeat: no-repeat;
    pointer-events: none;
    z-index: 1;
  }

  .quicklinks-container {
    position: absolute;
    top: 18%;
    left: 53.5%;
    width: 40%;
    height: 75%;
    z-index: 2;
  }

  .quicklinks-header {
    position: absolute;
    top: -8%;
    left: 48%;
    width: 38%;
    height: auto;
    pointer-events: none;
  }

  .quick-links {
    display: flex;
    flex-direction: column;
    gap: 1.35cqw;
  }

  .quick-links a {
    color: white;
    text-decoration: underline;
    font-family: "Inter", sans-serif;
    font-size: 1.05cqw;
    line-height: 1.3;
    white-space: nowrap;
  }
</style>
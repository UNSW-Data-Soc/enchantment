---
const { speed = 0.4, centerX, centerY, class: className = '' } = Astro.props;
const parallaxSpeed = Number(speed);
const hasCenter = centerX !== undefined || centerY !== undefined;
const positionStyle = hasCenter
	? `--parallax-center-x: ${centerX ?? '50%'}; --parallax-center-y: ${centerY ?? '50%'};`
	: undefined;
---

<div
	class={`parallax-container ${className}`}
	data-parallax-speed={parallaxSpeed}
	data-parallax-centered={hasCenter ? '' : undefined}
	style={positionStyle}
>
	<slot />
</div>

<style>
	/* Not inherited, so per-frame updates don't restyle everything inside the container. A descendant that reads the
	   offset must be marked data-parallax-follow (the script writes it there too), or it reads 0px. */
	@property --parallax-offset {
		syntax: '<length>';
		inherits: false;
		initial-value: 0px;
	}

	.parallax-container {
		will-change: transform;
		transform: translateY(var(--parallax-offset, 0px));
	}

	.parallax-container[data-parallax-centered] {
		position: absolute;
		left: var(--parallax-center-x);
		top: var(--parallax-center-y);
		transform: translate(-50%, calc(-50% + var(--parallax-offset, 0px)));
	}
</style>

<script>
	type ParallaxState = {
		container: HTMLElement;
		scrollSource: HTMLElement | Window;
		// Scroll position at which the container's centre sits at the viewport centre; its offset is 0 there.
		restScroll: number;
		followers: HTMLElement[];
	};

	const getScrollSource = (element: HTMLElement): HTMLElement | Window => {
		let parent = element.parentElement;

		while (parent) {
			const overflowY = getComputedStyle(parent).overflowY;
			if (/(auto|scroll|overlay)/.test(overflowY)) return parent;
			parent = parent.parentElement;
		}

		return window;
	};

	const getScrollPosition = (source: HTMLElement | Window) =>
		source === window ? window.scrollY : (source as HTMLElement).scrollTop;

	const getViewportCentre = (source: HTMLElement | Window) =>
		source === window
			? window.innerHeight / 2
			: (source as HTMLElement).getBoundingClientRect().top + (source as HTMLElement).clientHeight / 2;

	// Anchoring to the viewport centre (not to the scroll position at page load) keeps layers lined up
	// wherever they sit on the page, and gives the same layout after a reload mid-page.
	const measure = (state: ParallaxState) => {
		const rect = state.container.getBoundingClientRect();
		const offset = parseFloat(state.container.style.getPropertyValue('--parallax-offset')) || 0;
		state.restScroll =
			getScrollPosition(state.scrollSource) + rect.top - offset + rect.height / 2 - getViewportCentre(state.scrollSource);
	};

	const states = Array.from(document.querySelectorAll<HTMLElement>('[data-parallax-speed]')).map((container) => {
		const followers = Array.from(container.querySelectorAll<HTMLElement>('[data-parallax-follow]'));
		const state = { container, scrollSource: getScrollSource(container), restScroll: 0, followers };
		measure(state);
		return state;
	});
	const motionPreference = window.matchMedia('(prefers-reduced-motion: reduce)');

	// Takes the scroll position read once per frame: reading it after another container's write forces a style recalc.
	const updateParallax = (state: ParallaxState, scroll: number) => {
		const speed = Number(state.container.dataset.parallaxSpeed) || 0;
		const offset = `${motionPreference.matches ? 0 : (state.restScroll - scroll) * speed}px`;
		[state.container, ...state.followers].forEach((element) => element.style.setProperty('--parallax-offset', offset));
	};

	const sources = new Map<HTMLElement | Window, ParallaxState[]>();
	states.forEach((state) => {
		const sourceStates = sources.get(state.scrollSource) ?? [];
		sourceStates.push(state);
		sources.set(state.scrollSource, sourceStates);
	});

	sources.forEach((sourceStates, source) => {
		let frame = 0;
		const update = () => {
			if (frame) return;
			frame = requestAnimationFrame(() => {
				frame = 0;
				const scroll = getScrollPosition(source);
				sourceStates.forEach((state) => updateParallax(state, scroll));
			});
		};

		const remeasure = () => {
			sourceStates.forEach(measure);
			update();
		};

		update();
		source.addEventListener('scroll', update, { passive: true });
		if (source === window) source.addEventListener('v2-lenis-scroll', update, { passive: true });
		// Sizes change once images load and on resize (layouts here are in vw).
		window.addEventListener('load', remeasure);
		window.addEventListener('resize', remeasure);
	});

	motionPreference.addEventListener('change', () =>
		states.forEach((state) => updateParallax(state, getScrollPosition(state.scrollSource))),
	);
</script>
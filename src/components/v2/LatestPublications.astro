---
import ParallaxContainer from './ParallaxContainer.astro';
import outboundArrow from '../../assets/ui/buttons/white-outbound-arrow.svg?url';

// Placeholder cards in Landing V3's colours until there's publications data to show.
const cards = ['#3a4150', '#3a4150', '#cc735e', '#ffea7d'];
---

<section class="latest-publications" aria-labelledby="latest-publications-heading">
  <!-- Parallax speed rises towards the foreground, as in Latest Events. -->
  <ParallaxContainer speed={0.12}>
    <div class="title">
      <h2 id="latest-publications-heading">
        <img src="/text-headers/latest-publications.png" alt="Latest Publications" />
      </h2>
      <a class="more" href="/v2/publications" aria-label="All publications">
        <img src={outboundArrow} alt="" />
      </a>
    </div>
  </ParallaxContainer>

  <ParallaxContainer speed={0.2}>
    <div class="ticker">
      <!-- Three copies so the loop never shows a gap: one copy is narrower than the ticker. -->
      <ul class="cards" aria-hidden="true">
        {[...cards, ...cards, ...cards].map((colour) => <li style={`background: ${colour}`} />)}
      </ul>
    </div>
  </ParallaxContainer>
</section>

<style>
  /* Sizes are vw so the section scales with the full-width homepage background; values measured from Landing V3. */
  .latest-publications {
    /* Scaled down like Latest Events; the margin keeps the scaled cards centred in the background's gradient band. */
    zoom: 0.85;
    margin-top: -11vw;
  }

  .title {
    position: relative;
  }

  h2 {
    margin: 0 0 0 5.5vw;
  }

  h2 img {
    display: block;
    width: 35.3vw;
  }

  .more {
    position: absolute;
    top: 7.89vw;
    left: 39.35vw;
    transition: transform 0.3s;
  }

  .more:hover {
    transform: scale(1.1);
  }

  /* The button's cream square matches the page, so the shadow from Landing V3 is what shows its edge. */
  .more img {
    display: block;
    width: 2.6vw;
    filter: drop-shadow(0.1vw 0.2vw 0.3vw rgb(0 0 0 / 0.15));
  }

  /* Cards scroll continuously across the band and pass behind the dark bar (StarsScrollbar repaints it on top);
     hovering pauses the strip and lifts the card. */
  .ticker {
    overflow-x: clip;
  }

  .cards {
    display: flex;
    gap: 3.35vw;
    width: max-content;
    margin: 1.4vw 0 0;
    /* Trailing space equal to the gap, so a third of the strip is exactly one copy of the cards. */
    padding: 0 3.35vw 0 0;
    list-style: none;
    animation: scroll 40s linear infinite;
  }

  .cards:hover {
    animation-play-state: paused;
  }

  @keyframes scroll {
    to {
      transform: translateX(calc(-100% / 3));
    }
  }

  .cards li {
    width: 14.84vw;
    aspect-ratio: 304 / 400;
    border-radius: 0.6vw;
    box-shadow: 0 4px 16px rgb(0 0 0 / 0.12);
    transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .cards li:hover {
    transform: translateY(-1vw) scale(1.05);
  }

  @media (prefers-reduced-motion: reduce) {
    .cards {
      animation: none;
    }
  }
</style>

---
import { fetchEvents, type FacebookEvent } from '../../api/api.ts';
import ParallaxContainer from './ParallaxContainer.astro';
import clusterBg from '../../assets/ui/shapes/blue-red-cluster.svg?url';
import arrowLeft from '../../assets/ui/buttons/round-arrow-grey-left.svg?url';
import arrowRight from '../../assets/ui/buttons/round-grey-arrow-right.svg?url';

// fetchEvents never throws; failures come back as { error } JSON.
const { pastEvents = [] }: { pastEvents?: FacebookEvent[] } = await (await fetchEvents()).json();

const events = pastEvents.toSorted((a, b) => Date.parse(b.start_time) - Date.parse(a.start_time)).slice(0, 7);
// Empty slots keep the layout intact when the Facebook fetch returns nothing (e.g. expired token).
const slots: (FacebookEvent | null)[] = events.length ? events : [null, null, null];
const start = events.length ? 0 : 1;
---

<section class="latest-events" aria-labelledby="latest-events-heading">
	<!-- Parallax speed rises towards the foreground. -->
	<div class="bg">
		<ParallaxContainer speed={0.06}><img src={clusterBg} alt="" loading="lazy" draggable="false" /></ParallaxContainer>
	</div>
	<h2 id="latest-events-heading">
		<ParallaxContainer speed={0.12}>
      <!-- Update href to /v2/updates or /v2/latest-events once file created -->
      <div class="relative">
        <a href="/v2/events" aria-label="Latest Events" class="peer absolute z-10 left-[20%] right-[20%] top-[20%] bottom-[30%]"></a>
        <!-- alt is empty because the link above already reads "Latest Events"; with both, the heading is read twice. -->
        <img src="/text-headers/latest-events.png" alt="" draggable="false" class="transition duration-300 ease-out peer-hover:scale-103 peer-focus-visible:scale-103" />
      </div>
    </ParallaxContainer>
	</h2>

  <div class="tagline">
    {/* The spaces keep the words apart where phones drop the line breaks. */}
    <ParallaxContainer speed={0.12}>Stay up <br />to date <br />with <br />our latest <br />events <br />and <br />activities!</ParallaxContainer>
  </div>

  <ParallaxContainer speed={0.2}>
    <div class="viewport">
      <ul class="track" style={`--i: ${start}`}>
        {slots.map((event, i) => (
          <li class="card" data-active={i === start ? '' : undefined} aria-hidden={event ? undefined : 'true'}>
            {event && (
              <a href={`https://www.facebook.com/events/${event.id}`} target="_blank" rel="noopener noreferrer" tabindex={i === start ? undefined : -1}>
                <img src={event.cover?.source ?? '/icons/datasoc/unsw-datasoc-logo-v2.png'} alt={event.name} loading="lazy" />
                <span class="sr-only"> (opens in a new tab)</span>
              </a>
            )}
          </li>
        ))}
      </ul>
    </div>

    <div class="controls">
      <!-- Disabled with no events: they would only cycle the empty placeholder slots. -->
      <button type="button" data-dir="-1" aria-label="Previous event" disabled={!events.length}>
        <img src={arrowLeft} alt="" draggable="false" />
      </button>
      <button type="button" data-dir="1" aria-label="Next event" disabled={!events.length}>
        <img src={arrowRight} alt="" draggable="false" />
      </button>
    </div>
    <p class="sr-only" aria-live="polite" data-carousel-status></p>
  </ParallaxContainer>
</section>

<style>
  /* Sizes are vw so the section scales with the full-width homepage background; values measured from Landing V3. */
  .latest-events {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    align-items: center;
    /* Landing V3 drew the components larger than intended; scales the whole section down evenly. */
    zoom: 0.85;
  }

  .bg {
    position: absolute;
    top: -21.7vw;
    left: 50%;
    transform: translateX(-50%);
    z-index: -1;
    pointer-events: none;
  }

  .bg img {
    display: block;
    height: 71.4vw;
    /* Its wrapper is shrink-to-fit, so a global img { max-width: 100% } reset (e.g. Tailwind's) would squash it. */
    max-width: none;
  }

  h2 {
    margin: 0;
  }

  h2 img {
    display: block;
    width: 34.9vw;
  }

  /* Cream inside the fallback ring, which alone is too faint where it crosses the background's blue at phone widths. */
  h2 a:focus-visible {
    box-shadow: 0 0 0 2px #fffcf3;
  }

  .tagline {
    position: absolute;
    top: -9.1vw;
    right: 1.35vw;
    font-family: var(--font-syne);
    font-size: 1.5vw;
    line-height: 2.93;
    letter-spacing: 0.41em;
    text-align: right;
    /* Landing V3 uses #1995cb (3.3:1 on the cream bg); darkened to pass WCAG AA. */
    color: #137aa8;
  }

  /* Shows exactly the centre card and its two neighbours; clips sideways only so the scaled-up centre card isn't cropped. */
  .viewport {
    width: 61.5vw; /* three 20.5vw cards */
    overflow-x: clip;
    /* Room for the scaled-up centre card and its shadow, since WebKit clips this vertically too; the negative margin
       cancels it out. The padding mustn't take taps meant for the heading's link, so only the track does. */
    padding-block: 3rem;
    margin-block: -3rem;
    pointer-events: none;
    /* Horizontal swipes go to the script below; vertical ones still scroll the page, and pinch-zoom still works. */
    touch-action: pan-y pinch-zoom;
  }

  .track {
    pointer-events: auto;
    display: flex;
    margin: 0;
    padding: 0;
    list-style: none;
    /* Percentages, not vw: zoom scales the cards' layout but not a vw length inside transform, so vw slides drift. */
    transform: translateX(calc((1 - var(--i)) * 100% / 3));
    transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .card {
    flex: 0 0 calc(100% / 3);
    aspect-ratio: 16 / 10;
    border-radius: 4px;
    overflow: hidden;
    background: #c3ffff;
    box-shadow: 0 4px 16px rgb(0 0 0 / 0.12);
    transform: scale(0.74);
    cursor: pointer;
    transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .card[data-active] {
    transform: scale(1.08);
  }

  .card a,
  .card img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* On the card, because its overflow: hidden clips a ring drawn around the link inside. */
  .card:has(a:focus-visible) {
    outline: 2px solid #243b53;
    outline-offset: 3px;
  }

  .controls {
    display: flex;
    justify-content: center;
    margin-top: 2.4vw;
    gap: 1.5vw;
  }

  .controls button {
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    transition: transform 0.3s;
  }

  /* Hover only where it can end; on touch screens it would stick after a tap. */
  @media (hover: hover) {
    .controls button:hover {
      transform: scale(1.1);
    }

    .card[data-active]:hover {
      transform: scale(1.13);
      transition-duration: 0.3s;
    }
  }

  .controls button:active {
    transform: scale(0.92);
    transition-duration: 0.1s;
  }

  .controls img {
    display: block;
    width: 4vw;
  }

  /* Phones (either way up) and small tablets: the homepage stacks its sections (see HomePage), so this one is sized
     for reading rather than scaled with the background. Everything is sized from HomePage's phone-width --column, so
     on wider screens the dot cloud's chevrons still sit beside the arrows. The centre card takes 62% of it, spaced so
     its neighbours peek in at the edges of the screen, and the tagline becomes one sentence. Keep this media query
     the same as HomePage's and LatestPublications'. */
  @media (max-width: 48rem), (max-height: 30rem) and (pointer: coarse) {
    .latest-events {
      zoom: 1;
    }

    .bg {
      top: calc(var(--column) * -0.12);
    }

    .bg img {
      height: calc(var(--column) * 1.1);
    }

    h2 img {
      width: calc(var(--column) * 0.7);
    }

    /* Last, below the arrows, so it isn't read over the dot cloud. */
    .tagline {
      order: 1;
      position: static;
      margin: 2.5rem 1rem 0;
      font-size: 0.95rem;
      line-height: 1.5;
      letter-spacing: 0.2em;
      text-align: center;
    }

    .tagline br {
      display: none;
    }

    /* Full width, so the side cards run off the screen rather than being cut off at the column's edges. */
    .latest-events > :global(.parallax-container) {
      align-self: stretch;
    }

    .viewport {
      width: 100%;
    }

    .track {
      --card: calc(var(--column) * 0.62);
      --step: calc(var(--card) * 1.08);
      gap: calc(var(--step) - var(--card));
      transform: translateX(calc(50% - var(--card) / 2 - var(--i) * var(--step)));
    }

    .card {
      flex-basis: var(--card);
    }

    /* Close together, clear of the chevrons in the dot cloud's artwork. */
    .controls {
      margin-top: 1.75rem;
      gap: 1rem;
    }

    .controls img {
      width: 2.75rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .track,
    .card {
      transition: none;
    }
  }
</style>

<script>
  const section = document.querySelector('.latest-events')!;
  const track = section.querySelector<HTMLElement>('.track')!;
  const cards = Array.from(track.children);
  const status = section.querySelector<HTMLElement>('[data-carousel-status]')!;
  let index = Number(track.style.getPropertyValue('--i'));

  const goTo = (next: number) => {
    // Wraps by sliding back across the track; clone the cards for a seamless infinite loop if that feels jarring.
    index = (next + cards.length) % cards.length;
    track.style.setProperty('--i', String(index));
    cards.forEach((card, i) => {
      card.toggleAttribute('data-active', i === index);
      card.querySelector('a')?.setAttribute('tabindex', i === index ? '0' : '-1');
    });
    // Announces the centred event; the placeholder slots shown when there are no events stay silent.
    const name = cards[index].querySelector('img')?.alt;
    status.textContent = name ? `${name}, event ${index + 1} of ${cards.length}` : '';
  };

  section.querySelectorAll<HTMLButtonElement>('button[data-dir]').forEach((button) => {
    button.addEventListener('click', () => goTo(index + Number(button.dataset.dir)));
  });

  // A side card brings itself to the centre instead of following its link.
  cards.forEach((card, i) => {
    card.addEventListener('click', (event) => {
      if (i === index) return;
      event.preventDefault();
      goTo(i);
    });
  });

  // Swiping the cards (or dragging them with a mouse) moves one card. It only counts once the pointer has travelled
  // further sideways than down, so a scroll that starts on a card still scrolls the page.
  // With no events there's nothing to swipe through, only the empty placeholder slots.
  const viewport = section.querySelector<HTMLElement>('.viewport')!;
  const hasEvents = cards.some((card) => card.querySelector('a'));
  let swipeStart: { x: number; y: number } | null = null;
  let swiped = false;
  viewport.addEventListener('pointerdown', (event) => {
    if (event.button !== 0 || !hasEvents) return;
    swipeStart = { x: event.clientX, y: event.clientY };
    swiped = false;
  });
  viewport.addEventListener('pointermove', (event) => {
    // No button held: a mouse drag that was released outside the carousel, whose pointerup never arrived here.
    if (!event.buttons) swipeStart = null;
    if (!swipeStart || swiped) return;
    const dx = event.clientX - swipeStart.x;
    if (Math.abs(dx) < 35 || Math.abs(dx) <= Math.abs(event.clientY - swipeStart.y)) return;
    swiped = true;
    goTo(index - Math.sign(dx));
  });
  // A swipe cancels only the click that ends it, which fires before this timeout; a touch swipe has none, and a later
  // click (Enter on the card's link, say) must go through. On window, so a mouse released outside the carousel ends it.
  for (const type of ['pointerup', 'pointercancel']) {
    addEventListener(type, () => {
      swipeStart = null;
      setTimeout(() => (swiped = false));
    });
  }
  // Otherwise a mouse drag drags the card's image or link instead.
  viewport.addEventListener('dragstart', (event) => event.preventDefault());
  viewport.addEventListener('click', (event) => {
    // Keyboard and assistive-tech activations (detail 0) are never the end of a swipe.
    if (!swiped || event.detail === 0) return;
    event.preventDefault();
    event.stopPropagation();
  }, true);
</script>

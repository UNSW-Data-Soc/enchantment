---
import { fetchEvents, type FacebookEvent } from '../../api/api.ts';
import ParallaxContainer from './ParallaxContainer.astro';
import clusterBg from '../../assets/ui/shapes/blue-red-cluster.svg?url';
import arrowLeft from '../../assets/ui/buttons/round-arrow-grey-left.svg?url';
import arrowRight from '../../assets/ui/buttons/round-grey-arrow-right.svg?url';

const { pastEvents = [] }: { pastEvents?: FacebookEvent[] } = await (await fetchEvents()).json();

const events = pastEvents.toSorted((a, b) => Date.parse(b.start_time) - Date.parse(a.start_time)).slice(0, 7);
const slots: (FacebookEvent | null)[] = events.length ? events : [null, null, null];
const start = events.length ? 0 : 1;
---

<section class="latest-events" aria-labelledby="latest-events-heading">
  <div class="bg">
    <ParallaxContainer speed={0.06}><img src={clusterBg} alt="" loading="lazy" /></ParallaxContainer>
  </div>
  <h2 id="latest-events-heading">
    <ParallaxContainer speed={0.12}><img src="/text-headers/latest-events.png" alt="Latest Events" /></ParallaxContainer>
  </h2>

  <div class="tagline">
    <ParallaxContainer speed={0.12}>Stay up<br /> to date<br /> with<br /> our latest<br /> events<br /> and<br /> activities!</ParallaxContainer>
  </div>

  <div class="carousel-container">
    <div class="viewport">
      <ul class="track" style={`--i: ${start}`}>
        {slots.map((event, i) => (
          <li class="card" data-active={i === start ? '' : undefined}>
            {event && (
              <a href={`https://www.facebook.com/events/${event.id}`} target="_blank" rel="noopener noreferrer" tabindex={i === start ? undefined : -1}>
                <img src={event.cover?.source ?? '/icons/datasoc/unsw-datasoc-logo-v2.png'} alt={event.name} loading="lazy" />
              </a>
            )}
          </li>
        ))}
      </ul>
    </div>

    <div class="controls">
      <button type="button" data-dir="-1" aria-label="Previous event">
        <img src={arrowLeft} alt="" />
      </button>
      <button type="button" data-dir="1" aria-label="Next event">
        <img src={arrowRight} alt="" />
      </button>
    </div>
  </div>
</section>

<style>
  /* Desktop Styles */
  .latest-events {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    align-items: center;
    zoom: 0.85;
  }

  .bg {
    position: absolute;
    top: -21.7vw;
    left: 50%;
    transform: translateX(-50%);
    z-index: -1;
    pointer-events: none;
  }

  .bg img {
    display: block;
    height: 71.4vw;
    max-width: none;
  }

  h2 {
    margin: 0;
  }

  h2 img {
    display: block;
    width: 34.9vw;
  }

  .tagline {
    position: absolute;
    top: -9.1vw;
    right: 1.35vw;
    font-family: var(--font-syne);
    font-size: 1.5vw;
    line-height: 2.93;
    letter-spacing: 0.41em;
    text-align: right;
    color: #137aa8;
  }

  .carousel-container {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .viewport {
    width: 61.5vw;
    overflow-x: clip;
  }

  .track {
    display: flex;
    margin: 0;
    padding: 0;
    list-style: none;
    transform: translateX(calc((1 - var(--i)) * 100% / 3));
    transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .card {
    flex: 0 0 calc(100% / 3);
    aspect-ratio: 16 / 10;
    border-radius: 4px;
    overflow: hidden;
    background: #c3ffff;
    box-shadow: 0 4px 16px rgb(0 0 0 / 0.12);
    transform: scale(0.74);
    cursor: pointer;
    transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .card[data-active] {
    transform: scale(1.08);
  }

  .card[data-active]:hover {
    transform: scale(1.13);
    transition-duration: 0.3s;
  }

  .card a,
  .card img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .controls {
    display: flex;
    justify-content: center;
    margin-top: 2.4vw;
    gap: 1.5vw;
  }

  .controls button {
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    transition: transform 0.3s;
  }

  .controls button:hover {
    transform: scale(1.1);
  }

  .controls button:active {
    transform: scale(0.92);
    transition-duration: 0.1s;
  }

  .controls img {
    display: block;
    width: 4vw;
  }

  @media (prefers-reduced-motion: reduce) {
    .track,
    .card {
      transition: none;
    }
  }

  /* Mobile: same three-slot track as desktop, but the side cards are invisible.
     Each slot is 55vw wide, so the viewport is 55vw x 3 = 165vw
     (it overflows the screen, but only the centre slot is ever visible).
     The centre card is 55vw wide. Change BOTH numbers together to resize it:
     e.g. 50vw card = 150vw viewport, 60vw card = 180vw viewport. */
  @media (max-width: 768px) {
    .latest-events {
      zoom: 1;
      width: 100%;
      padding-bottom: 2rem;
    }

    .bg {
      display: none;
    }

    h2 img {
      width: 70vw;
      max-width: 400px;
      margin: 0 auto;
    }

    .tagline {
      position: static;
      font-size: 1rem;
      line-height: 1.4;
      letter-spacing: 0.1em;
      font-weight: 700;
      text-align: center;
      margin: 0.75rem auto 1.25rem;
      width: 80%;
    }

    .tagline br {
      display: none;
    }

    .viewport {
      width: 165vw;
      flex-shrink: 0;
    }

    .card {
      transform: scale(0.6);
      opacity: 0;
      pointer-events: none;
      transition:
        transform 0.5s cubic-bezier(0.22, 1, 0.36, 1),
        opacity 0.5s ease;
    }

    .card[data-active],
    .card[data-active]:hover {
      transform: scale(1);
      opacity: 1;
      pointer-events: auto;
    }

    .controls {
      margin-top: 1rem;
      gap: 2rem;
    }

    .controls img {
      width: 2.5rem;
    }
  }
</style>

<script>
  const section = document.querySelector('.latest-events');
  if (section) {
    const track = section.querySelector('.track');
    if (track) {
      const cards = Array.from(track.children);
      let index = Number((track as HTMLElement).style.getPropertyValue('--i')) || 0;

      const goTo = (next: number) => {
        index = (next + cards.length) % cards.length;
        (track as HTMLElement).style.setProperty('--i', String(index));
        cards.forEach((card, i) => {
          card.toggleAttribute('data-active', i === index);
          card.querySelector('a')?.setAttribute('tabindex', i === index ? '0' : '-1');
        });
      };

      section.querySelectorAll('button[data-dir]').forEach((button) => {
        button.addEventListener('click', () => {
          const dir = Number((button as HTMLElement).dataset.dir) || 0;
          goTo(index + dir);
        });
      });

      cards.forEach((card, i) => {
        card.addEventListener('click', (event) => {
          if (i === index) return;
          event.preventDefault();
          goTo(i);
        });
      });
    }
  }
</script>

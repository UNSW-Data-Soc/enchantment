---
import { fetchEvents, type FacebookEvent } from '../../api/api.ts';
import ParallaxContainer from './ParallaxContainer.astro';
import clusterBg from '../../assets/ui/shapes/blue-red-cluster.svg?url';
import arrowLeft from '../../assets/ui/buttons/round-arrow-grey-left.svg?url';
import arrowRight from '../../assets/ui/buttons/round-grey-arrow-right.svg?url';

// fetchEvents never throws; failures come back as { error } JSON.
const { pastEvents = [] }: { pastEvents?: FacebookEvent[] } = await (await fetchEvents()).json();

const events = pastEvents.toSorted((a, b) => Date.parse(b.start_time) - Date.parse(a.start_time)).slice(0, 7);
// Empty slots keep the layout intact when the Facebook fetch returns nothing (e.g. expired token).
const slots: (FacebookEvent | null)[] = events.length ? events : [null, null, null];
const start = events.length ? 0 : 1;
---

<section class="latest-events" aria-labelledby="latest-events-heading">
  <!-- Parallax speed rises towards the foreground. -->
  <div class="bg">
    <ParallaxContainer speed={0.06}><img src={clusterBg} alt="" loading="lazy" /></ParallaxContainer>
  </div>
  <h2 id="latest-events-heading">
    <ParallaxContainer speed={0.12}><img src="/text-headers/latest-events.png" alt="Latest Events" /></ParallaxContainer>
  </h2>

  <div class="tagline">
    <ParallaxContainer speed={0.12}>Stay up<br />to date<br />with<br />our latest<br />events<br />and<br />activities!</ParallaxContainer>
  </div>

  <ParallaxContainer speed={0.2}>
    <div class="viewport">
      <ul class="track" style={`--i: ${start}`}>
        {slots.map((event, i) => (
          <li class="card" data-active={i === start ? '' : undefined}>
            {event && (
              <a href={`https://www.facebook.com/events/${event.id}`} target="_blank" rel="noopener noreferrer" tabindex={i === start ? undefined : -1}>
                <img src={event.cover?.source ?? '/icons/datasoc/unsw-datasoc-logo-v2.png'} alt={event.name} loading="lazy" />
              </a>
            )}
          </li>
        ))}
      </ul>
    </div>

    <div class="controls">
      <button type="button" data-dir="-1" aria-label="Previous event">
        <img src={arrowLeft} alt="" />
      </button>
      <button type="button" data-dir="1" aria-label="Next event">
        <img src={arrowRight} alt="" />
      </button>
    </div>
  </ParallaxContainer>
</section>

<style>
  /* Sizes are vw so the section scales with the full-width homepage background; values measured from Landing V3. */
  .latest-events {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    align-items: center;
    zoom: 0.85;
  }

  .bg {
    position: absolute;
    top: -21.7vw;
    left: 50%;
    transform: translateX(-50%);
    z-index: -1;
    pointer-events: none;
  }

  .bg img {
    display: block;
    height: 71.4vw;
    max-width: none;
  }

  h2 {
    margin: 0;
  }

  h2 img {
    display: block;
    width: 34.9vw;
  }

  .tagline {
    position: absolute;
    top: -9.1vw;
    right: 1.35vw;
    font-family: var(--font-syne);
    font-size: 1.5vw;
    line-height: 2.93;
    letter-spacing: 0.41em;
    text-align: right;
    color: #137aa8;
  }

  .viewport {
    width: 61.5vw;
    overflow-x: clip;
  }

  .track {
    display: flex;
    margin: 0;
    padding: 0;
    list-style: none;
    transform: translateX(calc((1 - var(--i)) * 100% / 3));
    transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .card {
    flex: 0 0 calc(100% / 3);
    aspect-ratio: 16 / 10;
    border-radius: 4px;
    overflow: hidden;
    background: #c3ffff;
    box-shadow: 0 4px 16px rgb(0 0 0 / 0.12);
    transform: scale(0.74);
    cursor: pointer;
    transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .card[data-active] {
    transform: scale(1.08);
  }

  .card[data-active]:hover {
    transform: scale(1.13);
    transition-duration: 0.3s;
  }

  .card a,
  .card img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .controls {
    display: flex;
    justify-content: center;
    margin-top: 2.4vw;
    gap: 1.5vw;
  }

  .controls button {
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    transition: transform 0.3s;
  }

  .controls button:hover {
    transform: scale(1.1);
  }

  .controls button:active {
    transform: scale(0.92);
    transition-duration: 0.1s;
  }

  .controls img {
    display: block;
    width: 4vw;
  }

  @media (prefers-reduced-motion: reduce) {
    .track,
    .card {
      transition: none;
    }
  }

  /* ---------------- Responsive Mobile Scale ---------------- */
  @media (max-width: 768px) {
    .latest-events {
      zoom: 1;
      width: 100%;
      padding: 1rem 0;
    }

    h2 img {
      width: 82vw;
      max-width: 380px;
    }

    .tagline {
      position: static;
      font-size: 1.05rem;
      line-height: 1.45;
      letter-spacing: 0.12em;
      text-align: center;
      margin: 1rem 0 1.5rem;
    }

    .tagline br {
      display: none;
    }

    /* Single large card mode taking 88% of screen */
    .viewport {
      width: 88vw;
      max-width: 440px;
      overflow-x: clip;
    }

    .track {
      transform: translateX(calc((0 - var(--i)) * 100%));
    }

    .card {
      flex: 0 0 100%;
      aspect-ratio: 16 / 11;
      border-radius: 10px;
      transform: scale(1);
      box-shadow: 0 8px 24px rgb(0 0 0 / 0.25);
    }

    .card[data-active] {
      transform: scale(1);
    }

    .controls {
      margin-top: 1.25rem;
      gap: 3rem;
    }

    .controls button {
      min-width: 48px;
      min-height: 48px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .controls img {
      width: 2.75rem;
    }
  }
</style>

<script>
  const section = document.querySelector('.latest-events');
  if (section) {
    const track = section.querySelector('.track');
    if (track) {
      const cards = Array.from(track.children);
      let index = Number((track as HTMLElement).style.getPropertyValue('--i')) || 0;

      const goTo = (next: number) => {
        index = (next + cards.length) % cards.length;
        (track as HTMLElement).style.setProperty('--i', String(index));
        cards.forEach((card, i) => {
          card.toggleAttribute('data-active', i === index);
          card.querySelector('a')?.setAttribute('tabindex', i === index ? '0' : '-1');
        });
      };

      section.querySelectorAll('button[data-dir]').forEach((button) => {
        button.addEventListener('click', () => {
          const dir = Number((button as HTMLElement).dataset.dir) || 0;
          goTo(index + dir);
        });
      });

      cards.forEach((card, i) => {
        card.addEventListener('click', (event) => {
          if (i === index) return;
          event.preventDefault();
          goTo(i);
        });
      });
    }
  }
</script>

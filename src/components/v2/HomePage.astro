---
import Hero from './Hero.astro';
import LatestEvents from './LatestEvents.astro';
import LatestPublications from './LatestPublications.astro';
import StarsScrollbar from './StarsScrollbar.astro';
---

<link rel="preload" as="image" href="/backgrounds/homepage-bg-v2-p00-no-sidebar.png" fetchpriority="high" />

<main id="main-content" tabindex="-1" class="v2-home" aria-label="Homepage">
  <div class="hero-slot">
    <Hero />
  </div>

  {/* data-section gives each section a scrollbar star, in page order (the hero's is on Hero's own section);
      data-focus-target is where a star moves keyboard focus. */}
  <div class="latest-events-slot" data-section="Latest Events" data-focus-target="#latest-events-heading">
    <LatestEvents />
  </div>

  {/* Stands in for About Us, which isn't on main yet, as its band of the desktop background. When the About Us section
      lands (origin/Tony/website-v2-about-us), put this element's data-section on its slot and delete this band. */}
  <div class="section-band" data-section="About Us" style="top: 49.6%; height: 28.2%"></div>

  <div
    class="latest-publications-slot"
    data-section="Latest Publications"
    data-focus-target="#latest-publications-heading"
  >
    <LatestPublications />
  </div>

  <StarsScrollbar />
</main>

<style>
  .v2-home {
    position: relative;
    width: 100%;
    aspect-ratio: 1708 / 4989;
    --height-ratio: calc(4989 / 1708);
    background-image: url('/backgrounds/homepage-bg-v2-p00-no-sidebar.png');
    background-size: 100% auto;
    background-repeat: no-repeat;
    /* StarsScrollbar positions its bar's colours in cqw (1% of this width). */
    container-type: inline-size;
  }

  /* Each slot spans its section's band of the background, so its scrollbar star lights up over that band. Padding
     places the content within it; padding percentages are of the width, hence the height ratio. */
  .hero-slot {
    position: absolute;
    top: 0;
    left: 4.2%;
    right: 0;
    height: 28%;
  }

  .latest-events-slot {
    position: absolute;
    top: 28%;
    left: 2.6%;
    right: 0;
    box-sizing: border-box;
    height: 21.6%;
    padding-top: calc(3.8% * var(--height-ratio));
  }

  .latest-publications-slot {
    position: absolute;
    top: 77.8%;
    left: 0;
    right: 0;
    box-sizing: border-box;
    height: 22.2%;
    padding-top: calc(5.2% * var(--height-ratio));
  }

  .section-band {
    position: absolute;
    left: 0;
    right: 0;
    pointer-events: none;
  }

  /* Phones (either way up) and small tablets: the sections stack, each sized for reading, and only the hero keeps the
     background art. LatestEvents, LatestPublications and StarsScrollbar repeat this media query; keep all four the
     same. */
  @media (max-width: 48rem), (max-height: 30rem) and (pointer: coarse) {
    .v2-home {
      /* The phone-width column both sections size themselves from. */
      --column: min(100vw, 26rem);
      aspect-ratio: auto;
      padding-bottom: 3rem;
      background: #fffcf3;
    }

    .hero-slot,
    .latest-events-slot,
    .latest-publications-slot {
      position: relative;
      inset: auto;
      height: auto;
      padding-top: 0;
    }

    .hero-slot {
      box-sizing: border-box;
      height: calc(var(--height-ratio) * 33cqw);
      /* Over half the screen, so the Top star is lit at the top of the page. vh doesn't resize with phone toolbars. */
      min-height: 60vh;
      padding-left: 4.2%;
      /* The art's top 33%, where it fades to cream, scaled up (cropping the sides) when min-height makes the slot
         taller. */
      background: url('/backgrounds/homepage-bg-v2-p00-no-sidebar.png') top / auto calc(100% * 100 / 33) no-repeat;
      /* The art's left edge is still orange at the crop. */
      mask-image: linear-gradient(#000 80%, transparent);
    }

    .latest-publications-slot {
      margin-top: 3.5rem;
    }

    /* Layers drifting at different speeds pull stacked sections apart, e.g. a heading away from its cards. */
    .v2-home :global(.parallax-container) {
      transform: none;
    }

    /* The About Us band is a fraction of the desktop page with no section here, so it gets no star. */
    .section-band {
      display: none;
    }
  }
</style>
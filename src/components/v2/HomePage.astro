---
import Hero from './Hero.astro';
import LatestEvents from './LatestEvents.astro';
import LatestPublications from './LatestPublications.astro';
import StarsScrollbar from './StarsScrollbar.astro';
---

<link
  rel="preload"
  as="image"
  href="/backgrounds/homepage-bg-v2-p00.png"
  fetchpriority="high"
/>

<main class="v2-home" aria-label="Homepage">
  <div class="hero-slot">
    <Hero />
  </div>

  <div class="latest-events-slot">
    <LatestEvents />
  </div>

  <div class="latest-publications-slot">
    <LatestPublications />
  </div>

  <div class="section-band" data-section="Top" style="top: 0; height: 28%"></div>
  <div class="section-band" data-section="Latest Events" style="top: 28%; height: 21.6%"></div>
  <div class="section-band" data-section="About Us" style="top: 49.6%; height: 28.2%"></div>
  <div class="section-band" data-section="Latest Publications" style="top: 77.8%; height: 22.2%"></div>

  <StarsScrollbar />
</main>

<style>
  .v2-home {
    position: relative;
    width: 100%;
    aspect-ratio: 1708 / 4989;
    background-image: url('/backgrounds/homepage-bg-v2-p00.png');
    background-size: 100% auto;
    background-repeat: no-repeat;
  }

  .hero-slot {
    position: absolute;
    top: 0;
    left: 4.2%;
    right: 0;
    height: 25.7%;
  }

  .latest-events-slot {
    position: absolute;
    top: 31.8%;
    left: 2.6%;
    right: 0;
  }

  .latest-publications-slot {
    position: absolute;
    top: 83%;
    left: 0;
    right: 0;
  }

  .section-band {
    position: absolute;
    left: 0;
    right: 0;
    pointer-events: none;
  }
</style>
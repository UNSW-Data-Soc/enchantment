---
import Footer from './Footer.astro';
import PageHeader from './PageHeader.astro';
import StarsScrollbar from './StarsScrollbar.astro';
import V2Layout from '../../layouts/V2Layout.astro';

interface Props {
  title: string;
  titleAccent?: string;
  eyebrow?: string;
  eyebrowDetail?: string;
  caption?: string;
  index?: string;
}

const { title, titleAccent, eyebrow = 'UNSW DataSoc', eyebrowDetail, caption, index } = Astro.props;
---

<V2Layout title={`${title} - UNSW DataSoc`}>
  <link slot="head" rel="preload" as="image" href="/backgrounds/homepage-bg-v2-p00-no-sidebar.png" fetchpriority="high" />
  <div class="content-page">
    <StarsScrollbar
      length="100%"
      underlay="/backgrounds/homepage-bg-v2-p00-no-sidebar.png"
      underlaySize="100% 100%"
    />
    <main class="content-panel">
      <PageHeader
        title={title}
        titleAccent={titleAccent}
        eyebrow={eyebrow}
        eyebrowDetail={eyebrowDetail}
        caption={caption}
        index={index}
      />
      <div class="content-body">
        <slot />
      </div>
    </main>
    <div class="rail-tail-space" aria-hidden="true"></div>
  </div>
  <Footer />
</V2Layout>

<style>
  .content-page {
    --stars-scrollbar-width: 4.2;
    position: relative;
    isolation: isolate;
    min-height: 100vh;
    container-type: inline-size;
    overflow: clip;
    color: #34394b;
    background:
      radial-gradient(circle, rgb(52 57 75 / 0.16) 1px, transparent 1.5px) 0 0 / 18px 18px,
      linear-gradient(135deg, #e7c5c1, #e0d5e7 36%, #c8dce3 70%, #e9d3bd);
    font-family: var(--font-syne), sans-serif;
  }

  .content-panel {
    position: relative;
    width: auto;
    margin: 0 calc(var(--stars-scrollbar-width) * 1vw + clamp(10px, 1.4vw, 22px));
    overflow: clip;
    border-right: 1px solid rgb(72 75 112 / 0.12);
    border-left: 1px solid rgb(72 75 112 / 0.12);
    background: transparent;
    box-shadow: 0 0 3rem rgb(52 57 75 / 0.08);
  }

  .content-body {
    min-height: 12rem;
    padding: clamp(1.5rem, 3.5vw, 3rem) clamp(1.25rem, 2vw, 1.75rem) clamp(2rem, 4vw, 3.5rem);
    font-size: clamp(1rem, 1.4vw, 1.2rem);
    background: #fffcf3;
  }

  .rail-tail-space {
    height: clamp(2.5rem, 5vw, 4rem);
    background: #fffcf3;
  }

  @media (max-width: 640px) {
    .content-panel {
      margin: 0 calc(var(--stars-scrollbar-width) * 1vw + 8px);
      border: 0;
    }
  }
</style>

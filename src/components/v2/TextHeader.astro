// The homepage's two-line section headers, as vector outlines so they stay sharp at any size and don't depend on a
// font loading. Each keeps the viewBox of the PNG it replaced, so layouts sized around that image still line up.
// The outlines are the design's own lettering (Syne Bold and TAN Summers Regular), taken from its Canva PDF export,
// "datasoc website" DAHNZX2aoR0. TAN Summers is a commercial font, so it isn't loaded as a web font.
interface Line {
  d: string;
  // Gradient stops run across the line's ink, left to right.
  colours: string[];
  from: number;
  to: number;
}


interface Props {
  variant: keyof typeof variants;
  class?: string;
}

const { variant, class: className } = Astro.props;
const { width, height, lines } = variants[variant];
const id = `text-header-${variant}`;
---

<svg
  class:list={['text-header', className]}
  viewBox={`0 0 ${width} ${height}`}
  width={width}
  height={height}
  aria-hidden="true"
>
  <defs>
    {lines.map((line, index) => (
      <linearGradient id={`${id}-${index}`} gradientUnits="userSpaceOnUse" x1={line.from} x2={line.to} y1="0" y2="0">
        {line.colours.map((colour, stop) => (
          <stop offset={stop / (line.colours.length - 1)} stop-color={colour} />
        ))}
      </linearGradient>
    ))}
    <filter id={`${id}-shadow`} x="-10%" y="-20%" width="120%" height="150%">
      <feDropShadow dx="0" dy="4" stdDeviation="7" flood-color="#000" flood-opacity="0.3" />
    </filter>
  </defs>
  <g filter={`url(#${id}-shadow)`}>
    {lines.map((line, index) => (
      <path d={line.d} fill={`url(#${id}-${index})`} />
    ))}
  </g>
</svg>


---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

type Props = {
    member: { name: string; role: string };
    image?: ImageMetadata;
    sizes: string;
    eager?: boolean;
};

const { member, image, sizes, eager = false } = Astro.props;
const widths = [240, 380, 540];
---

{image ? (
    <Image
        src={image}
        alt={`Portrait of ${member.name}`}
        widths={widths}
        sizes={sizes}
        quality={75}
        loading={eager ? 'eager' : 'lazy'}
        decoding="async"
        class="member-photo w-full object-cover"
    />
) : (
    <div
        class="member-photo photo-placeholder w-full flex items-center justify-center"
        role="img"
        aria-label={`Photo unavailable for ${member.name}`}
    >
        <span>Photo unavailable</span>
    </div>
)}
<p class="member-name">{member.name}</p>
<p class="member-role">{member.role}</p>

<style>
    .member-photo {
        height: clamp(9rem, 16vw, 15rem);
        border-radius: 0.12rem;
    }

    .photo-placeholder {
        border: 1px solid rgb(255 252 243 / 0.24);
        background: #242a4a;
        color: #e4e8f4;
        font-size: 0.875rem;
        letter-spacing: 0.04em;
    }

    .member-name {
        margin: 0.9rem 0 0;
        color: #484b70;
        font-size: 1rem;
        font-weight: 700;
    }

    .member-role {
        margin: 0.2rem 0 0;
        color: #087fae;
        font-size: 0.875rem;
    }

    @media (max-width: 640px) {
        .member-photo {
            height: clamp(8.5rem, 34vw, 12rem);
        }
    }
</style>
